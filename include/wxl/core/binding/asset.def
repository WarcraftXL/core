//
// The Asset domain of the client binding: what a model, a map object and a placed doodad answer
// while the client loads them.
//
// `shared` is the CM2Shared* and `map_obj` the CMapObj* a seam was handed; `def` is the
// CMapDoodadDef* a CMap::CreateDoodadDef overload answered.

#ifndef WXL_BINDING
#error "define WXL_BINDING(name, ret, params, args, absent) before including asset.def"
#endif

// The model's path, CM2Shared::m_fileName: what CM2Cache::CreateShared opened it by.
WXL_BINDING(model_path, const char*, (const void* shared), (shared), 0)

// The model file's bytes, CM2Shared::m_data, read whole by then, and their count, m_fileSize.
// Null when the model holds none.
WXL_BINDING(model_bytes, const void*, (const void* shared, uint32_t* size), (shared, size), 0)

// Puts `size` other bytes in place of the model's: a copy in a buffer of the client's own
// allocator for model data (SIMD::AllocA16), which becomes m_data, m_fileSize set to `size`, the
// buffer read freed (SIMD::FreeA16). The client then parses the copy as it would have parsed the
// file. False, the model untouched, when the copy could not be made.
WXL_BINDING(model_replace_bytes, wxl_bool, (void* shared, const void* bytes, uint32_t size), (shared, bytes, size), WXL_FALSE)

// The map object's path, CMapObj::m_wmoName, and its root file's bytes, m_pWmoData and
// m_wmoFileSize. Null when it holds none.
WXL_BINDING(map_obj_path, const char*, (const void* map_obj), (map_obj), 0)
WXL_BINDING(map_obj_bytes, const void*, (const void* map_obj, uint32_t* size), (map_obj, size), 0)

// Where a placed doodad is, in world coordinates: CMapDoodadDef::m_position.
WXL_BINDING(doodad_position, wxl_bool, (const void* def, wxl_vec3* out), (def, out), WXL_FALSE)

// A terrain tile CMapArea::AsyncCallback is handed: its place on the map's grid (m_index), the
// open file it was read from (m_file, an SFileImpl the client still holds) and the file's bytes
// (m_fileBuffer, m_fileSize). Null bytes when it holds none.
WXL_BINDING(map_area_bytes, const void*, (const void* area, int32_t* x, int32_t* y, void** file, uint32_t* size), (area, x, y, file, size), 0)

// The name an open file was opened by, copied: SFile::GetActualFileName. False when there is
// no file.
WXL_BINDING(file_name, wxl_bool, (void* file, char* buffer, uint32_t capacity), (file, buffer, capacity), WXL_FALSE)

// A map object's group: its file's bytes (m_filePtr, m_fileSize), the map object it belongs to
// (m_parent, a CMapObj) and its number, its slot in the parent's m_mapObjGroupArray. Null when
// it holds no bytes.
WXL_BINDING(map_obj_group_bytes, const void*, (const void* group, void** parent, uint32_t* index, uint32_t* size), (group, parent, index, size), 0)

// A model's skin profile as read: CM2Shared::m_skinData. Null when it holds none.
WXL_BINDING(model_skin_bytes, const void*, (const void* shared), (shared), 0)

// A texture's file name: CTexture::m_filename.
WXL_BINDING(texture_name, const char*, (const void* texture), (texture), 0)

// --- What the client holds, read again (wxl.storage's reload_asset) -----------------------------

// Drops from the client's model cache (CM2Cache::m_shared) every model file whose file name, its
// folder aside, is `leaf` ("murloc.m2", any case): each is unlinked from the cache's hash as
// CM2Shared's destructor unlinks it, so the next CM2Cache::CreateShared of that name reads the file
// again, while the models made from it keep it until their last reference goes and frees it. Up to
// `capacity` of them are written to `out`; the answer is how many were dropped. Main thread.
WXL_BINDING(m2_cache_evict, uint32_t, (const char* leaf, void** out, uint32_t capacity), (leaf, out, capacity), 0)

// Makes a unit's or a player's model again from its display, CGUnit_C::UpdateDisplayInfo(1), as
// SMSG_FORCE_DISPLAY_UPDATE does: the model is created again by name, through the model cache.
// False, nothing done, for any other object. Main thread.
WXL_BINDING(unit_update_display, wxl_bool, (void* object), (object), WXL_FALSE)

// Reads again, in place, every BLP texture of the client's texture list (s_textureList) whose name
// is `name` (CTexture::m_filename: the path without its extension, any case): `name`.blp is read
// whole and handed to PumpBlpTextureAsync on each, which replaces its pixels and its device
// texture as a first load does. A texture still loading (m_asyncObject) is left alone and counted
// in `busy`; one held in a block of the interface's atlas (m_atlas: a square texture of 64 pixels
// or less the interface asked to share one) cannot be read again in place and is counted in
// `atlas`. A texture the interface offered the atlas (m_flags 4) that it did not take is an
// ordinary one. The answer is how many were read again. Main thread.
WXL_BINDING(texture_reload, uint32_t, (const char* name, uint32_t* busy, uint32_t* atlas), (name, busy, atlas), 0)

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
