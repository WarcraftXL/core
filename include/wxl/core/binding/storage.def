//
// The Storage domain of the client binding: the client's own file layer, as wxl.storage drives it.
//
// A path is the client's own: backslash-separated, case-insensitive, relative to the data root. A
// `file` is whatever the client's open handed back, opaque to everything above; it is closed with
// file_close and nothing else may be done with it.

#ifndef WXL_BINDING
#error "define WXL_BINDING(name, ret, params, args, absent) before including storage.def"
#endif

// Whether a name resolves to anything in the mounted set, without opening it.
WXL_BINDING(file_exists, wxl_bool, (const char* path), (path), WXL_FALSE)

// Opens a file, or answers null. Every handle answered here must reach file_close.
WXL_BINDING(file_open, void*, (const char* path), (path), 0)

// The file's length in bytes.
WXL_BINDING(file_size, uint64_t, (void* file), (file), 0)

// Moves the read cursor to an absolute offset. False when it did not land there.
WXL_BINDING(file_seek, wxl_bool, (void* file, uint64_t offset), (file, offset), WXL_FALSE)

// Reads up to `count` bytes at the cursor and answers how many it got.
WXL_BINDING(file_read, uint32_t, (void* file, void* buffer, uint32_t count), (file, buffer, count), 0)

WXL_BINDING(file_close, void, (void* file), (file), (void)0)

// Adds an archive to what the client searches. Higher priority wins a name collision; the
// client's own data is 0. There is no unmount: the client has none either.
WXL_BINDING(archive_mount, wxl_bool, (const char* path, int32_t priority), (path, priority), WXL_FALSE)

// The folder the client finds loose files from, SFile::m_basePath: "C:\Games\WoW\" with its
// separator, empty or null before the client set it.
WXL_BINDING(storage_base_path, const char*, (void), (), 0)

// Tells `fn` every name the listfile of each mounted archive holds, archive by archive, with
// SFile::List; answers how many archives were listed. An archive without a listfile adds none.
// Opens each "(listfile)" through the client's open, on the calling thread.
WXL_BINDING(archive_list, uint32_t, (wxl_core_name_fn fn, void* user), (fn, user), 0)

// The client's file stack, System_File::Stacked::s_manager, by address: the node it points at is
// the top of the stack every Blizzard::File call dispatches through, and the runtime's file layer
// writes its verbs into that node (see wxl/core/filestack.hpp).
WXL_BINDING(filestack_top, void**, (void), (), 0)

// The stack the client starts with, System_File::Stacked::s_initstack: while the top is this one,
// the client has not built its stack yet and nothing may be written into it.
WXL_BINDING(filestack_initial, const void*, (void), (), 0)

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
