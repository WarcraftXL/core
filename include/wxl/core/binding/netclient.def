//
// The NetClient domain of the client binding: a message in flight, as the NetClient seams read it.
//
// A `message` is the CDataStore the client passes to NetClient::ProcessMessage or NetClient::Send,
// positioned at its opcode: the bytes from m_read to m_size are the message, and m_data is the
// buffer they live in. Nothing here writes: a mod that wants the message not to happen suppresses
// it at the seam.

#ifndef WXL_BINDING_FIELD
#error "define WXL_BINDING_FIELD(name, ret, Type, member, absent) before including netclient.def"
#endif

// The buffer the message lives in, null when the store holds nothing.
WXL_BINDING_FIELD(message_data, const void*, CDataStore, m_data, 0)

// One past the last byte of the message, as an offset into that buffer.
WXL_BINDING_FIELD(message_size, uint32_t, CDataStore, m_size, 0)

// The read cursor: where the message starts for whoever is about to read it. A store that has
// been reset carries 0xFFFFFFFF here, which is past m_size and says there is nothing to read.
WXL_BINDING_FIELD(message_read, uint32_t, CDataStore, m_read, 0)

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
