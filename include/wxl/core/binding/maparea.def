//
// The MapArea domain of the client binding: what a terrain tile (CMapArea) answers.
//
// `object` is the CMapArea* a seam was handed as `this`.

#ifndef WXL_BINDING
#error "define WXL_BINDING(name, ret, params, args, absent) before including maparea.def"
#endif

// The tile's index in the map's 64x64 grid: CMapArea::m_index, which CMap::LoadArea writes.
WXL_BINDING_FIELD(map_area_tile_x, int32_t, CMapArea, m_index.x, -1)
WXL_BINDING_FIELD(map_area_tile_y, int32_t, CMapArea, m_index.y, -1)

// The chunk a tile holds at its chunk column and row (0-15): CMapArea::m_mapChunks[16 * y + x],
// which CMapChunk::Create fills; null for an empty slot or indices out of range.
WXL_BINDING(map_area_chunk, void*, (const void* area, int32_t chunk_x, int32_t chunk_y), (area, chunk_x, chunk_y), 0)

// Points a split tile (a root ADT without MCIN, after CMapArea::ProcessIffChunks has read it) at
// its other files: m_chunkInfo, m_doodadDef, m_mapObjDef and their counts, m_m2FileNames,
// m_wmoFileNames, m_modelFilenamesOffsets, m_wmoFilenamesOffsets, m_textureFlags, then calls
// CMapArea::LoadTextures with the names. False for a null area. Main thread only.
WXL_BINDING(map_area_split_set, wxl_bool, (void* area, const wxl_core_area_split* split), (area, split), WXL_FALSE)

// A tile's placements as the client holds them: m_doodadDef, m_mapObjDef and their counts, the
// names and their offsets (the members of wxl_core_area_split up to map_obj_offsets; the rest left
// zero). False for a null area.
WXL_BINDING(map_area_placements, wxl_bool, (const void* area, wxl_core_area_split* out), (area, out), WXL_FALSE)

// The map's far terrain read from a WDL of later clients (CMapLowDetail): the bytes copied into a
// block of the client's own (SMemAlloc, which CMapLowDetail::Unload frees), m_data set to it,
// m_areaOffsets to its MAOF data at `area_offsets`, no map objects. Answers the block, null for
// none. Main thread only.
WXL_BINDING(map_low_detail_set, void*, (void* detail, const void* bytes, uint32_t size, uint32_t area_offsets), (detail, bytes, size, area_offsets), 0)

// One far-terrain area: CMap::AllocAreaLow, its fields set as CMapLowDetail::Load sets them, and
// put in m_areas. False when the client's heap has no room (the area is left out).
WXL_BINDING(map_area_low_add, wxl_bool, (void* detail, const wxl_core_area_low* area), (detail, area), WXL_FALSE)

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
