//
// The Input domain of the client binding: the pointer as the game draws it and picks with it.
// Main thread only.

#ifndef WXL_BINDING
#error "define WXL_BINDING(name, ret, params, args, absent) before including input.def"
#endif

// Whether the device draws the pointer: CGxDevice::m_cursorVisible. False with no device.
WXL_BINDING(input_cursor_visible, wxl_bool, (void), (), WXL_FALSE)

// Shows or hides the pointer the device draws, hardware or not: the device's own
// CGxDevice::CursorSetVisible (virtual; the D3D devices also show or hide the hardware cursor).
// The game's idea of the pointer (CGInputControl::m_mouseModeFlags) is left alone, so it goes on
// picking under it. Nothing with no device.
WXL_BINDING(input_cursor_set_visible, void, (wxl_bool visible), (visible), (void)0)

// Gives the pointer's look back to the game: CGInputControl::UpdateMouseMode(force) on the active
// input control, which shows or hides it as the game's own state says. With no input control, the
// device's CursorSetVisible(true).
WXL_BINDING(input_cursor_restore, void, (void), (), (void)0)

// Whether the pointer is over the 3D world: CSimpleTop's m_mouseFocus is the world frame
// (CGWorldFrame::s_currentWorldFrame). False with no world frame.
WXL_BINDING(input_pointer_over_world, wxl_bool, (void), (), WXL_FALSE)

// The default action a mouse press noted, to be done at its release: CGInputControl's
// m_pendingDefaultAction, 0 none, 1 select (the left button), 2 act (the right one).
WXL_BINDING(input_pending_action, uint32_t, (const void* control), (control), 0)

// Forgets the default action a press noted.
WXL_BINDING(input_clear_pending_action, void, (void* control), (control), (void)0)

// Does what a click does at its release: CGWorldFrame::PerformDefaultAction(button) on the world
// frame, button 1 left (select), 4 right (act), on what the press noted under the pointer. False
// with no world frame.
WXL_BINDING(input_default_action, wxl_bool, (uint32_t button), (button), WXL_FALSE)

// Ends the game's mouse look, with no click: the noted action forgotten, then
// CGInputControl::UnsetControlBit of both look bits, as the game's MouselookStop does.
WXL_BINDING(input_mouse_look_stop, void, (void), (), (void)0)

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
