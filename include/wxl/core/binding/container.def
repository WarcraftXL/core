//
// The Container domain of the client binding: the bag descriptor block (CGContainerData).
//
// The rows read through CGContainer_C::m_container; the item rows of item.def apply to a container
// too.

#ifndef WXL_BINDING
#error "define WXL_BINDING(name, ret, params, args, absent) before including container.def"
#endif

WXL_BINDING_FIELD_VIA(container_num_slots, uint32_t, CGContainer_C, m_container, CGContainerData, m_containerFieldNumSlots, 0)

// The guid in a slot; the array is the client's 36 slots, the bag's own count is above.
WXL_BINDING_FIELD_VIA_INDEX(container_slot, uint64_t, CGContainer_C, m_container, CGContainerData, m_containerFieldSlot1)

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
