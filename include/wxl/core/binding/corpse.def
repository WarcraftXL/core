// The Corpse domain of the client binding: the corpse descriptor block (CGCorpseData).
//
// The rows read through CGCorpse_C::m_corpse; a corpse's position and facing come from its
// CPassenger, read by object_position and object_facing of object.def.

#ifndef WXL_BINDING
#error "define WXL_BINDING(name, ret, params, args, absent) before including corpse.def"
#endif

WXL_BINDING_FIELD_VIA(corpse_owner, uint64_t, CGCorpse_C, m_corpse, CGCorpseData, m_corpseFieldOwner, 0)
WXL_BINDING_FIELD_VIA(corpse_party, uint64_t, CGCorpse_C, m_corpse, CGCorpseData, m_corpseFieldParty, 0)
WXL_BINDING_FIELD_VIA(corpse_display_id, uint32_t, CGCorpse_C, m_corpse, CGCorpseData, m_corpseFieldDisplayId, 0)
WXL_BINDING_FIELD_VIA(corpse_guild, uint32_t, CGCorpse_C, m_corpse, CGCorpseData, m_corpseFieldGuild, 0)
WXL_BINDING_FIELD_VIA(corpse_flags, uint32_t, CGCorpse_C, m_corpse, CGCorpseData, m_corpseFieldFlags, 0)
WXL_BINDING_FIELD_VIA(corpse_dynamic_flags, uint32_t, CGCorpse_C, m_corpse, CGCorpseData, m_corpseFieldDynamicFlags, 0)

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
