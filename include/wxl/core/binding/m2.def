//
// The M2 domain of the client binding: the models objects draw with, character appearances, the
// models wxl.m2 hangs on them, and the model loader as wxl.m2file and the loader's events see it.
// A model is a CM2Model*, a model file a CM2Shared*, an appearance a CCharacterComponent*.

#ifndef WXL_BINDING
#error "define WXL_BINDING(name, ret, params, args, absent) before including m2.def"
#endif

// --- Appearances and models (wxl.m2, AppearanceChanged) ---------------------------------------

// What an appearance is, as the Component seams hand it over: its model, race, sex, whether it is
// an NPC's, and the display it wears on `item_slot` (0 for a slot out of range, or empty). Fills
// every member of the args but `change`. False, with nothing written, for no component.
WXL_BINDING(component_wearer, wxl_bool, (const void* component, uint32_t item_slot, wxl_appearance_args* out), (component, item_slot, out), WXL_FALSE)

// The model a world object (CGObject_C*) draws with, followed up what it hangs on: a mounted
// player answers its mount. Null for an object without one.
WXL_BINDING(m2_object_model, void*, (const void* object), (object), 0)

// The ItemDisplayInfo row `id`, strings pointing into the client's database. False for none.
WXL_BINDING(m2_item_display, wxl_bool, (uint32_t id, wxl_m2_item_display* out), (id, out), WXL_FALSE)

// ChrRaces' client prefix of `race` ("Hu"). Null for a race the client does not have.
WXL_BINDING(m2_race_prefix, const char*, (uint32_t race), (race), 0)

// A new model of `path` in the scene `scene_model` is in, one reference held by the caller:
// CM2Scene::CreateModel. Null for no scene model or when the scene makes none.
WXL_BINDING(m2_create_model, void*, (void* scene_model, const char* path), (scene_model, path), 0)

// Gives back one reference to `model`; the last one frees it: CM2Model::Release.
WXL_BINDING(m2_release_model, void, (void* model), (model), (void)0)

// CM2Model::AttachToParent, after checking the point exists when the parent has loaded: false,
// with nothing changed, when it has not and `to_root` is false.
WXL_BINDING(m2_attach_model, wxl_bool, (void* model, void* parent, uint32_t attachment, wxl_bool to_root), (model, parent, attachment, to_root), WXL_FALSE)

// CM2Model::DetachFromParent, for a model attached to something.
WXL_BINDING(m2_detach_model, void, (void* model), (model), (void)0)

// What `model` is attached to, null for nothing.
WXL_BINDING(m2_model_parent, void*, (const void* model), (model), 0)

// The model `model` was duplicated from (an interface copy of a character's tree), null for one
// made from a file.
WXL_BINDING(m2_model_source, void*, (const void* model), (model), 0)

// CM2Model::SetGeometryVisible: deferred by the client until the model has loaded.
WXL_BINDING(m2_set_geosets, void, (void* model, uint32_t first, uint32_t last, wxl_bool visible), (model, first, last, visible), (void)0)

// Replaces the texture of type `type` with the file `path`. False when the file makes none.
WXL_BINDING(m2_replace_texture, wxl_bool, (void* model, uint32_t type, const char* path), (model, type, path), WXL_FALSE)

// Up to `capacity` models attached to `model`, written to `out`; the answer is how many there are.
WXL_BINDING(m2_children, uint32_t, (const void* model, void** out, uint32_t capacity), (model, out, capacity), 0)

// The attachment point `model` hangs on and whether it was attached to the root. False when it
// hangs on nothing.
WXL_BINDING(m2_attach_info, wxl_bool, (const void* model, uint32_t* attachment, wxl_bool* to_root), (model, attachment, to_root), WXL_FALSE)

// Duplicates `source` into `parent`'s scene and attaches the copy, which the parent then owns: what
// CM2Model::Initialize does for the children of a model it copies.
WXL_BINDING(m2_attach_copy, wxl_bool, (void* source, void* parent, uint32_t attachment, wxl_bool to_root), (source, parent, attachment, to_root), WXL_FALSE)

// The file `model` was made from (its CM2Shared), as an opaque key: a copy shares it with the model
// it was copied from for its whole life, while the copy's link to that model is dropped once it
// has loaded.
WXL_BINDING(m2_model_file, void*, (const void* model), (model), 0)

// Attachment point `attachment` of a loaded `model`, in its bind pose. False for none or not loaded.
WXL_BINDING(m2_attachment_point, wxl_bool, (const void* model, uint32_t attachment, wxl_vec3* out), (model, attachment, out), WXL_FALSE)

// A loaded `model`'s skeleton and this frame's bone matrices, which the runtime poses a model
// wxl.m2 attached from. False for a model that has not loaded or has no matrices.
WXL_BINDING(m2_skeleton, wxl_bool, (void* model, wxl_core_m2_skeleton* out), (model, out), WXL_FALSE)

// --- The model loader (ModelParsed, SkinProfileParsed, ModelSequenceLoad, wxl.m2file) ----------

// What a model file is while it loads: its path, its header, how many bytes, and its skin profile
// once one has been read. False, with nothing written, for no file or one with no bytes.
WXL_BINDING(m2_file_info, wxl_bool, (const void* file, wxl_core_m2_file* out), (file, out), WXL_FALSE)

// Counts one more animated bone on the model file, so its models' shadow pass animates them.
WXL_BINDING(m2_file_animate_bones, void, (void* file), (file), (void)0)

// --- Models of the world, as wxl.m2's world calls drive them ------------------------------------

// A new model of `path` in the world's scene (World::s_m2Scene), one reference held by the caller.
// Null outside the world.
WXL_BINDING(m2_create_world_model, void*, (const char* path), (path), 0)

// Puts `model` in the world at `placement` (detached first), making its map entity the first time
// and moving it after. False outside the world.
WXL_BINDING(m2_place_world, wxl_bool, (void* model, const wxl_m2_placement* placement), (model, placement), WXL_FALSE)

// Takes `model` out of the world: its map entity destroyed. Nothing for a model never placed.
WXL_BINDING(m2_unplace_world, void, (void* model), (model), (void)0)

// The model's own transform: what it is moved by on the point it hangs on.
WXL_BINDING(m2_set_transform, void, (void* model, const wxl_m2_placement* placement), (model, placement), (void)0)

// Plays animation `anim` on every bone from its start at `speed`, or, while the model loads, once
// it has.
WXL_BINDING(m2_play_animation, void, (void* model, uint32_t anim, float speed), (model, anim, speed), (void)0)

// Whether the model's file has loaded.
WXL_BINDING(m2_loaded, wxl_bool, (const void* model), (model), WXL_FALSE)

// One play of animation `anim` of a loaded model, in milliseconds; 0 for none.
WXL_BINDING(m2_animation_length, uint32_t, (void* model, uint32_t anim), (model, anim), 0)

// The model's base alpha.
WXL_BINDING(m2_set_alpha, void, (void* model, float alpha), (model, alpha), (void)0)

// Whether its emitters and ribbons emit.
WXL_BINDING(m2_set_emitting, void, (void* model, wxl_bool emitting), (model, emitting), (void)0)

// Where attachment `attachment` of a loaded model is in the world. False for none or not loaded.
WXL_BINDING(m2_attachment_world, wxl_bool, (void* model, uint32_t attachment, wxl_vec3* out), (model, attachment, out), WXL_FALSE)

// The ground's height under `at`: World::Intersect from `up` above to `down` below with the flags
// the client's spell effects use (0x120111). False for no hit or outside the world.
WXL_BINDING(m2_ground_height, wxl_bool, (const wxl_vec3* at, float up, float down, float* out_z), (at, up, down, out_z), WXL_FALSE)

// A loaded model's bones as AnimateMT just posed them: its file, path, bone matrices (writable),
// its own matrix (m_matrixF4), the scene's camera-relative-to-world matrix (m_viewInv) and clock.
// False for a model not loaded or without bone matrices.
WXL_BINDING(m2_bones, wxl_bool, (void* model, wxl_m2_bones* out), (model, out), WXL_FALSE)

// Bone `index` of a model file (CM2Shared): its parent index and pivot. False past the last bone.
WXL_BINDING(m2_file_bone, wxl_bool, (const void* file, uint32_t index, int16_t* parent, wxl_vec3* pivot), (file, index, parent, pivot), WXL_FALSE)

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
