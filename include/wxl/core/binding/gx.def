// The Gx domain of the client binding: the graphics device, as the render seams need to read it.

#ifndef WXL_BINDING
#error "define WXL_BINDING(name, ret, params, args, absent) before including gx.def"
#endif

// Whether the client has a graphics device at all: what WXL_STAGE_GRAPHICS means. The device may
// still lack a context to draw into; that is gx_has_context's question, not this one.
WXL_BINDING(gx_device_exists, wxl_bool, (void), (), WXL_FALSE)

// Whether the device has a context to draw into now: false with no device, and while it is lost.
// With gx_window_visible, it is the test the client's own paint makes before it draws a frame.
WXL_BINDING(gx_has_context, wxl_bool, (void), (), WXL_FALSE)

// Whether the client's window can be seen: false with no device, and while it is minimised.
WXL_BINDING(gx_window_visible, wxl_bool, (void), (), WXL_FALSE)

// The size the client renders at, in pixels. False, with nothing written, when there is no device
// to ask: the client's own query does not check for one, so this does before it calls it.
WXL_BINDING(gx_window_size, wxl_bool, (uint32_t* width, uint32_t* height), (width, height), WXL_FALSE)

// The device itself, for wxl.gx: the client's IDirect3DDevice9. Null with no device, and on a
// device of another API.
WXL_BINDING(gx_d3d9_device, void*, (void), (), 0)

// The API of the client's device: its EGxApi (0 OpenGL, 1 Direct3D 9, 2 Direct3D 9Ex, 6 Vulkan on
// the recompiled client), -1 with no device. What wxl.gx's api answers from.
WXL_BINDING(gx_device_api, int32_t, (void), (), -1)

// Makes the client send all of its device state again before its next draw: what a mod calls
// after it set state on the device behind the client's copy of it. Nothing without a D3D9 device.
WXL_BINDING(gx_invalidate_state, void, (void), (), (void)0)

// The batch a model renderer (CM2SceneRender*) has just drawn: its model, the top of what that
// model hangs on, the numbers of the device's draw and its viewport. False when the device drew
// nothing for it (no context, a lost device).
WXL_BINDING(gx_model_draw, wxl_bool, (const void* render, wxl_model_batch_args* out), (render, out), WXL_FALSE)

// How the world is being drawn, for wxl.draw: the device's native projection (m_projNative, D3D's,
// z 0 to 1), the top of its view stack, its viewport (m_viewport, 0 to 1 of the window) and the
// window's size (m_curWindowRect), and CWorldScene::s_activeWorldView, the point the world's draws
// are made from. Read between two draws of the world, it is what they are drawn with. False with
// no device.
WXL_BINDING(gx_world_view, wxl_bool, (wxl_core_world_view* out), (out), WXL_FALSE)

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
