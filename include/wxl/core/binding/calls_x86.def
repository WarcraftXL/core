//
// The client functions the x86 binding calls for wxl.m2's models of the world and its bone
// watchers, for the object reads of what the player can do with a unit or a game object, for
// the textures wxl.selectioncircle draws the game's circles with, for wxl.cvar's variables, and
// for the interface's signature the FrameXML seam asks about (src/binding/BindingX86.cpp), as
// data: one row per function, with the convention and the parameters BindingX86 calls it with. check_conventions.py holds every row against Wow.exe
// as it holds the seams; BindingX86 resolves each symbol when it compiles.
//
//   WXL_BINDING_CALL_X86(domain, name, symbol, ret, conv, params)
//
// `symbol` is written as a seam's: "name", or "name@0x..." for a name several functions carry.
// A thiscall row names `this` first; a member that answers a struct by value takes the hidden
// pointer it writes it to as its first stack parameter.

#ifndef WXL_BINDING_CALL_X86
#error "define WXL_BINDING_CALL_X86(domain, name, symbol, ret, conv, params) before including calls_x86.def"
#endif

WXL_BINDING_CALL_X86(M2Call, SetLoadedCallback, "CM2Model::SetLoadedCallback", void, thiscall, (void* self, void* callback, void* arg))
WXL_BINDING_CALL_X86(M2Call, HasSequence, "CM2Model::HasSequence@0x00825EE0", int32_t, thiscall, (void* self, uint32_t id))
WXL_BINDING_CALL_X86(M2Call, SetBoneSequence, "CM2Model::SetBoneSequence", void, thiscall, (void* self, uint32_t bone, uint32_t sequence, uint32_t variation, uint32_t time, float speed, int32_t blend, int32_t primary))
WXL_BINDING_CALL_X86(M2Call, GetSequenceInfo, "CM2Model::GetSequenceInfo", void, thiscall, (void* self, uint32_t id, uint32_t variation, void* info))
WXL_BINDING_CALL_X86(M2Call, SetAnimating, "CM2Model::SetAnimating", void, thiscall, (void* self, int32_t animating))
WXL_BINDING_CALL_X86(M2Call, IsLoaded, "CM2Model::IsLoaded", uint32_t, thiscall, (void* self, int32_t wait, int32_t recursive))
WXL_BINDING_CALL_X86(M2Call, GetBoundingBox, "CM2Model::GetBoundingBox", void*, thiscall, (void* self, void* out))
WXL_BINDING_CALL_X86(M2Call, GetBoundingSphere, "CM2Model::GetBoundingSphere", void*, thiscall, (void* self, void* out))
WXL_BINDING_CALL_X86(M2Call, SetEmittersEnabled, "CM2Model::SetEmittersEnabled", void, thiscall, (void* self, int32_t enabled))
WXL_BINDING_CALL_X86(M2Call, SetRibbonsEnabled, "CM2Model::SetRibbonsEnabled", void, thiscall, (void* self, uint32_t enabled))
WXL_BINDING_CALL_X86(M2Call, HasAttachment, "CM2Model::HasAttachment", int32_t, thiscall, (void* self, uint32_t id))
WXL_BINDING_CALL_X86(M2Call, GetAttachmentPosition, "CM2Model::GetAttachmentPosition", void*, thiscall, (void* self, void* out, uint32_t id))
WXL_BINDING_CALL_X86(M2Call, RotateAroundX, "C44Matrix::RotateAroundX", void, thiscall, (void* self, float angle))
WXL_BINDING_CALL_X86(M2Call, RotateAroundY, "C44Matrix::RotateAroundY", void, thiscall, (void* self, float angle))
WXL_BINDING_CALL_X86(M2Call, RotateAroundZ, "C44Matrix::RotateAroundZ", void, thiscall, (void* self, float angle))
WXL_BINDING_CALL_X86(M2Call, Scale, "C44Matrix::Scale@0x004C1BF0", void, thiscall, (void* self, float scale))
WXL_BINDING_CALL_X86(M2Call, ObjectCreateStatic, "CMap::ObjectCreateStatic", void*, cdecl, (void* model, const void* matrix, void* func, void* func_param, uintptr_t param32))
WXL_BINDING_CALL_X86(M2Call, ObjectUpdate, "CMap::ObjectUpdate", void, cdecl, (void* entity, void* matrix, void* box, void* sphere, void* light, int32_t moved, uint32_t flags))
WXL_BINDING_CALL_X86(M2Call, ObjectDestroy, "World::ObjectDestroy", void, cdecl, (void* entity))
WXL_BINDING_CALL_X86(ObjectCall, CanAttack, "CGUnit_C::CanAttack", bool, thiscall, (const void* self, const void* target))
WXL_BINDING_CALL_X86(ObjectCall, CanInteractNow, "CGUnit_C::CanInteractNow", bool, thiscall, (const void* self, const void* target))
WXL_BINDING_CALL_X86(ObjectCall, CanHighlight, "CGGameObject_C::CanHighlight", bool, thiscall, (const void* self))
WXL_BINDING_CALL_X86(TextureCall, CreateTexture, "CreateTexture", void*, cdecl, (const char* path, void* status))
WXL_BINDING_CALL_X86(TextureCall, GetGlobalStatusObj, "GetGlobalStatusObj", void*, cdecl, ())
WXL_BINDING_CALL_X86(TextureCall, HandleClose, "HandleClose", void, cdecl, (void* handle))
WXL_BINDING_CALL_X86(CVarCall, Lookup, "CVar::Lookup", void*, cdecl, (const char* name))
WXL_BINDING_CALL_X86(CVarCall, Register, "CVar::Register", void*, cdecl, (const char* name, const char* help, uint32_t flags, const char* value, void* callback, uint32_t category, uint8_t set_command, void* arg, uint8_t unk))
WXL_BINDING_CALL_X86(CVarCall, Set, "CVar::Set@0x007668C0", bool, thiscall, (void* self, const char* value, uint8_t set_value, uint8_t set_reset, uint8_t set_default, uint8_t set_needs_save))
WXL_BINDING_CALL_X86(InterfaceCall, CheckSignature, "FrameXML_CheckSignature", int32_t, cdecl, (const char* toc, const char* extra, const uint8_t* modulus, uint8_t* digest))
WXL_BINDING_CALL_X86(InterfaceCall, MD5Init, "MD5Init", void, cdecl, (void* context))
WXL_BINDING_CALL_X86(InterfaceCall, ProcessFileForMakeSign, "ProcessFileForMakeSign", int32_t, cdecl, (void* context, const char* file, const char* base))
WXL_BINDING_CALL_X86(InterfaceCall, MD5Update, "MD5Update", void, cdecl, (void* context, const uint8_t* data, uint32_t size))
WXL_BINDING_CALL_X86(InterfaceCall, MD5Final, "MD5Final", void, cdecl, (uint8_t* digest, void* context))

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
