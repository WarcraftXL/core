//
// The client functions the x86 binding calls for wxl.m2's models of the world and its bone
// watchers, for the object reads of what the player can do with a unit or a game object, for
// the textures wxl.selectioncircle draws the game's circles with, for wxl.cvar's variables, for
// the interface's signature the FrameXML seam asks about, and for the ground wxl.terrain reshapes
// and the fall it starts (src/binding/BindingX86.cpp), and the device's own work the Vulkan
// renderer's adapter of the stock client keeps (src/gx/x86/), as data: one row per function, with
// the convention and the parameters BindingX86 calls it with. check_conventions.py holds every row against Wow.exe
// as it holds the seams; BindingX86 resolves each symbol when it compiles.
//
//   WXL_BINDING_CALL_X86(domain, name, symbol, ret, conv, params)
//
// `symbol` is written as a seam's: "name", or "name@0x..." for a name several functions carry.
// A thiscall row names `this` first; a member that answers a struct by value takes the hidden
// pointer it writes it to as its first stack parameter.

#ifndef WXL_BINDING_CALL_X86
#error "define WXL_BINDING_CALL_X86(domain, name, symbol, ret, conv, params) before including calls_x86.def"
#endif

