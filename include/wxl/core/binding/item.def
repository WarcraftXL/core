//
// The Item domain of the client binding: the item descriptor block (CGItemData).
//
// The rows read through CGItem_C::m_item, which an item and a container (a CGItem_C) both carry.

#ifndef WXL_BINDING
#error "define WXL_BINDING(name, ret, params, args, absent) before including item.def"
#endif

WXL_BINDING_FIELD_VIA(item_owner, uint64_t, CGItem_C, m_item, CGItemData, m_itemFieldOwner, 0)
WXL_BINDING_FIELD_VIA(item_contained_in, uint64_t, CGItem_C, m_item, CGItemData, m_itemFieldContained, 0)
WXL_BINDING_FIELD_VIA(item_creator, uint64_t, CGItem_C, m_item, CGItemData, m_itemFieldCreator, 0)
WXL_BINDING_FIELD_VIA(item_stack_count, int32_t, CGItem_C, m_item, CGItemData, m_itemFieldStackCount, 0)
WXL_BINDING_FIELD_VIA(item_duration, uint32_t, CGItem_C, m_item, CGItemData, m_itemFieldDuration, 0)
WXL_BINDING_FIELD_VIA(item_flags, uint32_t, CGItem_C, m_item, CGItemData, m_itemFieldFlags, 0)
WXL_BINDING_FIELD_VIA(item_durability, uint32_t, CGItem_C, m_item, CGItemData, m_itemFieldDurability, 0)
WXL_BINDING_FIELD_VIA(item_max_durability, uint32_t, CGItem_C, m_item, CGItemData, m_itemFieldMaxdurability, 0)

// The item's record in the client's item cache, or null while the client has not received it:
// CGItem_C::GetStats, which asks the cache without requesting the record. Main thread only.
// Its members below take the record.
WXL_BINDING(item_stats, const void*, (const void* object), (object), 0)
WXL_BINDING_FIELD(item_stats_quality, uint32_t, ItemStats_C, m_quality, 0)
WXL_BINDING_FIELD(item_stats_level, uint32_t, ItemStats_C, m_itemLevel, 0)
WXL_BINDING_FIELD(item_stats_required_level, uint32_t, ItemStats_C, m_requiredLevel, 0)
WXL_BINDING_FIELD(item_stats_class, uint32_t, ItemStats_C, m_class, 0)
WXL_BINDING_FIELD(item_stats_subclass, uint32_t, ItemStats_C, m_subClass, 0)
WXL_BINDING_FIELD(item_stats_inventory_type, uint32_t, ItemStats_C, m_inventoryType, 0)
WXL_BINDING_FIELD(item_stats_stackable, int32_t, ItemStats_C, m_stackable, 0)
WXL_BINDING_FIELD(item_stats_sell_price, uint32_t, ItemStats_C, m_sellPrice, 0)

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
