// The GameUI domain of the client binding: the game interface's own state.

#ifndef WXL_BINDING
#error "define WXL_BINDING(name, ret, params, args, absent) before including gameui.def"
#endif

// The guid the player has targeted, 0 for none: CGGameUI::m_lockedTarget, which only
// CGGameUI::Target and CGGameUI::ClearTarget write.
WXL_BINDING(ui_target_guid, uint64_t, (void), (), 0)

// Nonzero while the game interface is up: CGGameUI::m_initialized, set at the end of
// CGGameUI::Initialize and cleared by CGGameUI::Shutdown.
WXL_BINDING(ui_initialized, int32_t, (void), (), 0)

// Nonzero from the start of CGGameUI::InitializeFrameXML until the first world update after
// login: CGGameUI::m_loggingIn, a byte.
WXL_BINDING(ui_logging_in, uint8_t, (void), (), 0)

// Nonzero while a /reload rebuilds the game interface: CGGameUI::m_currentlyReloadingUI, a byte
// CGGameUI::Idle sets before its Shutdown and CGGameUI::Initialize clears after its EnterWorld.
WXL_BINDING(ui_reloading, uint8_t, (void), (), 0)

// A click on the terrain or a map object, as CGGameUI::HandleTerrainClick is handed one: the
// guid of the game object hit (0 for bare ground), the point, and the button as the client
// numbers it (1 left, 2 middle, 4 right).
WXL_BINDING_FIELD(terrain_click_guid, uint64_t, CTerrainClickEvent, m_guid, 0)
WXL_BINDING_FIELD(terrain_click_x, float, CTerrainClickEvent, m_point.x, 0.0f)
WXL_BINDING_FIELD(terrain_click_y, float, CTerrainClickEvent, m_point.y, 0.0f)
WXL_BINDING_FIELD(terrain_click_z, float, CTerrainClickEvent, m_point.z, 0.0f)
WXL_BINDING_FIELD(terrain_click_button, uint32_t, CTerrainClickEvent, m_button, 0)

// A click on an object's model, as CGGameUI::HandleSpriteClick is handed one: the object's
// guid and the button.
WXL_BINDING_FIELD(sprite_click_guid, uint64_t, CSpriteClickEvent, m_guid, 0)
WXL_BINDING_FIELD(sprite_click_button, uint32_t, CSpriteClickEvent, m_button, 0)

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
