//
// The client binding: every fact the runtime reads out of the client, one row per fact, one
// domain per file under binding/. ARCHITECTURE.md lists what a row generates and where.
//
// `name` is the fact's name on every side, `ret` the C type answered, `absent` what is answered
// when the client handed no accessor (x64) or the executable is not the client (x86).
//
//   WXL_BINDING(name, ret, params, args, absent)
//       a fact read by a call: params is the parenthesised parameter list, args the same names
//       in parentheses. Written by hand on each side, in BindingX86.cpp and in the fork's
//       WarcraftXL/Binding.cpp; a side without it fails to link.
//
//   WXL_BINDING_FIELD(name, ret, Type, member, absent)
//       ret name(const void* object): the object's member.
//
//   WXL_BINDING_FIELD_VIA(name, ret, Type, via, ViaType, member, absent)
//       the member of the ViaType block the object's `via` points at; absent when it is null.
//
//   WXL_BINDING_FIELD_VIA_INDEX(name, ret, Type, via, ViaType, member)
//       wxl_bool name(const void* object, uint32_t index, ret* out): element `index` of that
//       block's array `member`; false past its end.
//
//   WXL_BINDING_FIELD_VIA_AT(name, ret, Type, via, ViaType, member, Elem, elem_member)
//       the same for an array of Elem, reading each element's `elem_member`.
//
// Type, ViaType and Elem are classes of the client, by the names its source and layouts.def give
// them; via, member and elem_member are their members as the source writes them. A field row is
// generated on both sides: on x86 as a read at the offsets layouts.def measured, in the fork as
// the member access itself.
//
// The rows, in this order, are the members of wxl_core_init. The client hands its own rows over
// at init and the runtime refuses a client built from a different table, naming the first row
// that differs, so a row goes wherever it belongs in its domain file.
//
// A consumer defines WXL_BINDING and, when it realises field rows differently, the field shapes;
// those left undefined collapse onto WXL_BINDING with the signatures above.

#ifndef WXL_BINDING
#error "define WXL_BINDING(name, ret, params, args, absent) before including binding.def"
#endif

#ifndef WXL_BINDING_FIELD
    #define WXL_BINDING_FIELD(name, ret, Type, member, absent) \
        WXL_BINDING(name, ret, (const void* object), (object), absent)
    #define WXL_BINDING_FIELD_DEFAULTED
#endif

#ifndef WXL_BINDING_FIELD_VIA
    #define WXL_BINDING_FIELD_VIA(name, ret, Type, via, ViaType, member, absent) \
        WXL_BINDING(name, ret, (const void* object), (object), absent)
    #define WXL_BINDING_FIELD_VIA_DEFAULTED
#endif

#ifndef WXL_BINDING_FIELD_VIA_INDEX
    #define WXL_BINDING_FIELD_VIA_INDEX(name, ret, Type, via, ViaType, member) \
        WXL_BINDING(name, wxl_bool, (const void* object, uint32_t index, ret* out), (object, index, out), WXL_FALSE)
    #define WXL_BINDING_FIELD_VIA_INDEX_DEFAULTED
#endif

#ifndef WXL_BINDING_FIELD_VIA_AT
    #define WXL_BINDING_FIELD_VIA_AT(name, ret, Type, via, ViaType, member, Elem, elem_member) \
        WXL_BINDING(name, wxl_bool, (const void* object, uint32_t index, ret* out), (object, index, out), WXL_FALSE)
    #define WXL_BINDING_FIELD_VIA_AT_DEFAULTED
#endif

#include "wxl/core/binding/world.def"
#include "wxl/core/binding/objectmgr.def"
#include "wxl/core/binding/object.def"
#include "wxl/core/binding/unit.def"
#include "wxl/core/binding/player.def"
#include "wxl/core/binding/item.def"
#include "wxl/core/binding/container.def"
#include "wxl/core/binding/gameobject.def"
#include "wxl/core/binding/dynamicobject.def"
#include "wxl/core/binding/corpse.def"
#include "wxl/core/binding/gameui.def"
#include "wxl/core/binding/maparea.def"
#include "wxl/core/binding/script.def"
#include "wxl/core/binding/netclient.def"
#include "wxl/core/binding/storage.def"
#include "wxl/core/binding/gx.def"
#include "wxl/core/binding/spell.def"
#include "wxl/core/binding/m2.def"

#ifdef WXL_BINDING_FIELD_DEFAULTED
    #undef WXL_BINDING_FIELD
    #undef WXL_BINDING_FIELD_DEFAULTED
#endif
#ifdef WXL_BINDING_FIELD_VIA_DEFAULTED
    #undef WXL_BINDING_FIELD_VIA
    #undef WXL_BINDING_FIELD_VIA_DEFAULTED
#endif
#ifdef WXL_BINDING_FIELD_VIA_INDEX_DEFAULTED
    #undef WXL_BINDING_FIELD_VIA_INDEX
    #undef WXL_BINDING_FIELD_VIA_INDEX_DEFAULTED
#endif
#ifdef WXL_BINDING_FIELD_VIA_AT_DEFAULTED
    #undef WXL_BINDING_FIELD_VIA_AT
    #undef WXL_BINDING_FIELD_VIA_AT_DEFAULTED
#endif
