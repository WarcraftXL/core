//
// The Chat domain: seams on ChatFrame.cpp and ChatFrame_Scripts.cpp -- what the server says
// to the chat, and what the local player says through the interface.
//
// Every row but one is cdecl: the static members of CGChat with external linkage, a handler
// reached only through the handler table, and the two script functions whose address is taken
// for the script function table. PENDINGCHAT's destructor is a member: thiscall. The handlers
// read the message from its cursor without moving it, and raise nothing for a message cut short.
//
// A received message raises at the client's own decisions: ChatMessage at RecordChat, the
// commit of a line; ChatAddonMessage at CHAT_MSG_ADDON, which FrameScript.vSignalEvent sees
// fired while AddChatMessage adds an addon message.

#ifndef WXL_SEAM
#error "define WXL_SEAM(domain, name, symbol, ret, conv, params) before including chat.def"
#endif
#ifndef WXL_SEAM_BEFORE
#error "define WXL_SEAM_BEFORE(domain, name, symbol, ret, conv, params) before including chat.def"
#endif
#ifndef WXL_SEAM_AFTER
#error "define WXL_SEAM_AFTER(domain, name, symbol, ret, conv, params) before including chat.def"
#endif
#ifndef WXL_SEAM_GATE
#error "define WXL_SEAM_GATE(domain, name, symbol, ret, conv, params) before including chat.def"
#endif

// Parses one chat message and shows it: the type, the language, the sender's guid and a
// dword, then what the type adds -- a creature's name and the target for the monster types, a
// GM's name on a GM message, the channel's name for a channel message, the target's guid, the
// text, the chat tag, an achievement id. Then filters: a message from an ignored player
// (unless a GM's), a monster's said to an ignored one, a whisper the stranger filter refuses
// and a message not read to its end are dropped, and a foreign whisper becomes a whisper. What
// is left goes to AddChatMessage, once. Two callers, the handlers of
// SMSG_MESSAGECHAT and SMSG_GM_MESSAGECHAT, which differ only in is_gm. Before reads what the
// message carries and keeps it for AddChatMessage; After forgets it. Neither raises: the
// client's own decisions further on do.
WXL_SEAM(Chat, ChatMessageReceived, "CGChat::ChatMessageReceived", int32_t, cdecl, (void* msg, uint8_t is_gm))

// Adds one line to the chat: the client's own messages (system notices, loot, money, ...) and
// the received messages ChatMessageReceived let through, with the chat type the client settled
// on. It looks the names up in the name cache, then decides: a line whose sender's or target's
// name is not cached yet, or any line while the world is still loading, goes to QueueChatText
// and is added again from that copy once the name is known (CGChat::NameQueryCallback,
// CGChat::ProcessPendingChatQueue); an addon message (language 0xFFFFFFFF) goes to the interface
// as CHAT_MSG_ADDON; the UTF-8 check and the spam filter drop theirs; what is left is committed
// through RecordChat. Before tells which message a call adds -- the one ChatMessageReceived read
// (the same text, from inside it), one of those the client queued (the same text, its copy), or
// none, a line of the client's own -- for the seams below; it raises nothing itself.
WXL_SEAM_BEFORE(Chat, AddChatMessage, "CGChat::AddChatMessage", void, cdecl, (const char* text, int32_t type, const char* sender_name, uint32_t language, const char* channel_name, const char* target_name, const char* flags, uint64_t sender_guid, uint32_t sender_unk, uint64_t target_guid, int32_t achievement_id, uint8_t is_gm, const void* conversation))

// Keeps a line AddChatMessage cannot show yet: a PENDINGCHAT appended to CGChat::s_pendingChat
// with copies of the strings. One caller, AddChatMessage (0x0050AD82), which pushes seventeen
// dwords and cleans 0x44. After keeps what the message ChatMessageReceived read carries for the
// copy, so that the line raises when the client adds it again; nothing for the client's own lines.
WXL_SEAM_AFTER(Chat, QueueChatText, "CGChat::QueueChatText", void, cdecl, (const char* text, int32_t type, const char* sender_name, const char* target_name, uint32_t language, const char* channel_name, const char* flags, int32_t queued, int32_t unused, uint64_t sender_guid, uint32_t sender_unk, uint64_t target_guid, int32_t achievement_id, uint8_t is_gm, const void* conversation))

// Frees a queued line, once the client added it again or gave up on it (a name query that
// failed, the chat shut down). Called by every path that frees one: s_pendingChat's DeleteNode
// and its inlined copies in NameQueryCallback and ProcessPendingChatQueue, and the list's Clear.
// Before forgets what QueueChatText kept for it.
WXL_SEAM_BEFORE(Chat, DestroyPendingChat, "PENDINGCHAT::~PENDINGCHAT", void, thiscall, (void* self))

// Records a committed line in the chat history (CGChat::m_chatHistory, what a report of the
// player quotes) and numbers it: the line as the chat frames get it, its final type, the name it
// shows, the line id. One caller, AddChatMessage (0x0050A8A5), past every filter and right
// before SendChatEvent hands the line to the frames as CHAT_MSG_*; ten dwords pushed, cleaned
// with SendChatEvent's in one `add esp,0x50`. Before raises ChatMessage when the line is that of
// a message of the server, received now or queued before.
WXL_SEAM_BEFORE(Chat, RecordChat, "CGChat::RecordChat", void, cdecl, (const char* text, int32_t type, const char* sender_name, uint64_t sender_guid, uint32_t sender_unk, uint32_t zone_channel_id, const char* channel_name, uint32_t line_id, const void* player))
WXL_SEAM_RAISES(Chat, RecordChat, ChatMessage)

// The script's SendChatMessage(text [, type] [, language] [, target]): checks the player can
// speak, the arguments, the type's conditions (a target for a whisper, a group for party
// chat, ...), then builds CMSG_MESSAGECHAT and sends it. Every message typed in the chat edit
// box and every one an addon sends end here. Gate reads the arguments off the Lua stack and
// raises ChatSend; taking the call when a handler suppressed it answers no result, which is
// what the function answers for a message it did not send.
WXL_SEAM_GATE(Chat, Script_SendChatMessage, "Script_SendChatMessage", int32_t, cdecl, (void* state))
WXL_SEAM_RAISES(Chat, Script_SendChatMessage, ChatSend)

// The script's SendAddonMessage(prefix, text [, type] [, target]): joins the prefix and the
// text with a tab and sends them as CMSG_MESSAGECHAT in the addon language. Gate raises
// ChatSend with addon set, and takes the call as above.
WXL_SEAM_GATE(Chat, Script_SendAddonMessage, "Script_SendAddonMessage", int32_t, cdecl, (void* state))
WXL_SEAM_RAISES(Chat, Script_SendAddonMessage, ChatSend)

// The handler of SMSG_LOG_XPGAIN: the source's guid, the amount, the kind byte, for a kill
// the rested bonus and the group multiplier, then the refer-a-friend flag. Logs the gain to
// the chat. Before raises PlayerXpGain.
WXL_SEAM_BEFORE(Chat, Packet_SMSG_LOG_XPGAIN, "Packet_SMSG_LOG_XPGAIN", int32_t, cdecl, (void* param, uint32_t msg_id, uint32_t time, void* msg))
WXL_SEAM_RAISES(Chat, Packet_SMSG_LOG_XPGAIN, PlayerXpGain)

// The handler of SMSG_TEXT_EMOTE, a static member of CGChat reached only through the handler
// table: the sender, the emote, its variant and the target's name read in place; nothing for an
// ignored sender, the line queued while the sender's name is not known. Reads the message at
// [ebp+0x14] and ends in bare `ret`s: cdecl. Before raises TextEmote as the server sent it, the
// client's ignore list not consulted; the line the chat shows is ChatMessage's.
WXL_SEAM_BEFORE(Chat, OnTextEmote, "CGChat::OnTextEmote", int32_t, cdecl, (void* param, uint32_t msg_id, uint32_t time, void* msg))
WXL_SEAM_RAISES(Chat, OnTextEmote, TextEmote)

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
