//
// The seam table: every client function the runtime hooks, one domain per file. ARCHITECTURE.md
// shows what a row generates on each side.
//
//   WXL_SEAM(domain, name, symbol, ret, conv, params)         observes the call: Before and After
//   WXL_SEAM_BEFORE(domain, name, symbol, ret, conv, params)  observes its entry: Before
//   WXL_SEAM_AFTER(domain, name, symbol, ret, conv, params)   observes its return: After
//   WXL_SEAM_GATE(domain, name, symbol, ret, conv, params)    decides the call: Gate
//   WXL_SEAM_RAISES(domain, name, event)                      an event the seam's body raises
//   WXL_SEAM_WITNESS(domain, name, call)                      a call site the binary check reads
//   WXL_SEAM_X64_ONLY(domain, name, why)                      a seam the stock client cannot take
//
// Before runs when the function is entered and After when it returns; neither changes the call.
// A seam declares only the sides its body uses: on x64 each side is a call the fork's source has
// to make, an After one at every return of the function.
// Gate is handed every argument by address and answers whether it took the call: taken, the
// function does not run and Gate has written its result; not taken, the function runs with the
// arguments as Gate left them. A gate has no After, because on x64 an After is a call at every
// return of the function. A seam is a gate only when the contract needs a call stopped or an
// argument rewritten.
//
// Columns:
//
//   domain  the file the row is in; the first half of the seam's name ("World.Preload").
//   name    the client function, not what it is used for: the second half of the seam's name and
//           the namespace of its body (wxl::seam::World::Preload). Part of the ABI, never renamed.
//   symbol  the function as the client fork names it: what x86 resolves against functions.def and
//           where check_seams.py looks for the x64 call sites. "<name>@0x<address>" picks one of
//           several functions sharing a name; an ambiguous plain name does not compile.
//   ret     the return type at the C boundary, `void` for none. After takes it first.
//   conv    the x86 convention: cdecl, stdcall, thiscall (`this` first in params), or regparm.
//           Linkage decides: a free function, a class static, a member, or a static whose address
//           is taken keeps its declared convention; a file-level static whose address is never
//           taken may get one of the compiler's own, with arguments in registers, and is then
//           regparm, attached through a thunk in src/seams/RegparmX86.cpp. check_conventions.py
//           verifies the column against Wow.exe.
//   params  the arguments at the C boundary: a reference is a pointer, a client class is a `void*`
//           or its SDK struct. Before takes exactly these, After the result first. A `void*`
//           reaches a gate on x64 as the address of a local copy: it can be read, not rewritten.
//
// WXL_SEAM_RAISES rows follow their seam and name the event without WXL_EV_. Both runtimes publish
// their union as the events they raise, and check_seams.py checks each against the seam's body.
//
// WXL_SEAM_WITNESS rows follow their seam and give the x86 address of a `call` instruction that
// reaches the function, for a cdecl function whose own code does not show what it takes: one
// reached only through a pointer, which reads fewer arguments than it is handed, or one that
// leaves by a tail jump, with no `ret` to say who cleans. check_conventions.py reads the pushes
// before that call and the cleanup after it, and fails the row unless they add up to its stack
// parameters. Nothing else reads them.
//
// WXL_SEAM_X64_ONLY rows follow their seam, for one whose body needs what only the recompiled
// client has: the x86 runtime attaches no detour for it and does not announce its events, so a
// mod asking wxl_host.raises is told no and a subscription to them is refused; `why` is the line
// the runtime's log gives. Rows x64 only: Gx.D3d9ExIShaderCreatePixel and Vertex.
//
// Include with the four row shapes defined; WXL_SEAM_RAISES, WXL_SEAM_WITNESS and
// WXL_SEAM_X64_ONLY default to nothing.

// No defaults: a consumer that skips a shape says so by defining it to nothing.
#ifndef WXL_SEAM
#error "define WXL_SEAM(domain, name, symbol, ret, conv, params) before including seams.def"
#endif
#ifndef WXL_SEAM_BEFORE
#error "define WXL_SEAM_BEFORE(domain, name, symbol, ret, conv, params) before including seams.def"
#endif
#ifndef WXL_SEAM_AFTER
#error "define WXL_SEAM_AFTER(domain, name, symbol, ret, conv, params) before including seams.def"
#endif
#ifndef WXL_SEAM_GATE
#error "define WXL_SEAM_GATE(domain, name, symbol, ret, conv, params) before including seams.def"
#endif

#ifndef WXL_SEAM_RAISES
    #define WXL_SEAM_RAISES(domain, name, event)
    #define WXL_SEAM_RAISES_DEFAULTED
#endif
#ifndef WXL_SEAM_WITNESS
    #define WXL_SEAM_WITNESS(domain, name, call)
    #define WXL_SEAM_WITNESS_DEFAULTED
#endif
#ifndef WXL_SEAM_X64_ONLY
    #define WXL_SEAM_X64_ONLY(domain, name, why)
    #define WXL_SEAM_X64_ONLY_DEFAULTED
#endif

