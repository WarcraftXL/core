#include "wxl/seams/client.def"
#include "wxl/seams/sound.def"
#include "wxl/seams/scrn.def"
#include "wxl/seams/gx.def"
#include "wxl/seams/simpletop.def"
#include "wxl/seams/worldframe.def"
#include "wxl/seams/consoledevice.def"
#include "wxl/seams/spell.def"
#include "wxl/seams/item.def"
#include "wxl/seams/combat.def"
#include "wxl/seams/m2.def"
#include "wxl/seams/component.def"

#ifdef WXL_SEAM_RAISES_DEFAULTED
    #undef WXL_SEAM_RAISES
    #undef WXL_SEAM_RAISES_DEFAULTED
#endif
