// The ConsoleDevice domain: seams on the console's bringing up of the graphics device.

#ifndef WXL_SEAM_AFTER
#error "define WXL_SEAM_AFTER(domain, name, symbol, ret, conv, params) before including consoledevice.def"
#endif

// Creates the graphics device: picks the API and retries CreateGxDevice until one is made. Its one
// caller is InitializeGlobal, once, at process start (0x00406B28). It returns only with a device:
// every failure -- no device to be had, or one without two texture units -- shows a message and
// ends the process (exit(0)). After announces WXL_STAGE_GRAPHICS when the device exists.
//
// It falls between the other stages: InitializeGlobal reads its first client database
// (Startup_Strings.dbc, through SFile::OpenEx) just before calling this, and InitializeClient
// creates the script context (FrameScript_Initialize) after.
//
// It reads only its title; its caller pushes and cleans the two flags as well
// (`push 1; push 1; push title; call; add esp, 0xc`), so the row declares them.
WXL_SEAM_AFTER(ConsoleDevice, Initialize, "ConsoleDeviceInitialize", void, cdecl, (const char* title, bool unused_a2, bool unused_a3))

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
