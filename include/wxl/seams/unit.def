//
// The Unit domain: seams on CGUnit_C, the client's creatures and players.
//
// Every row but one is a non-static member: thiscall, `self` first. The mount display's mirror
// handler is a free function whose address is taken: cdecl.

#ifndef WXL_SEAM
#error "define WXL_SEAM(domain, name, symbol, ret, conv, params) before including unit.def"
#endif
#ifndef WXL_SEAM_AFTER
#error "define WXL_SEAM_AFTER(domain, name, symbol, ret, conv, params) before including unit.def"
#endif
#ifndef WXL_SEAM_BEFORE
#error "define WXL_SEAM_BEFORE(domain, name, symbol, ret, conv, params) before including unit.def"
#endif

// Runs when the unit's health reaches zero: the player's own OnDeath for a player, the attack
// state cleared, the death animation, the target dropped, the interact icon removed. After
// raises UnitDeath with the unit's handle, once the client has done all of that.
WXL_SEAM_AFTER(Unit, OnDeath, "CGUnit_C::OnDeath", void, thiscall, (void* self))
WXL_SEAM_RAISES(Unit, OnDeath, UnitDeath)

// Runs when an aura is added to the unit's aura slots: looks the spell up, adds its effect,
// logs it, and for the local player refreshes the action bar and the tracking and shapeshift
// state. `a3` is the harmful bit of the aura's flags, which the client passes along to the combat
// log; `aura` is the slot itself. After raises UnitAuraChanged with removed clear, and
// UnitAuraApplied with what the slot holds.
WXL_SEAM_AFTER(Unit, OnAuraAdded, "CGUnit_C::OnAuraAdded", void, thiscall, (void* self, uint32_t index, uint8_t a3, void* aura, int32_t spell_id))
WXL_SEAM_RAISES(Unit, OnAuraAdded, UnitAuraChanged)
WXL_SEAM_RAISES(Unit, OnAuraAdded, UnitAuraApplied)

// The counterpart: the aura left the unit's slots, and `aura` is the copy OnAuraUpdate kept of it
// from before the update. After raises UnitAuraChanged with removed set, and UnitAuraRemoved with
// what the aura was.
WXL_SEAM_AFTER(Unit, OnAuraRemoved, "CGUnit_C::OnAuraRemoved", void, thiscall, (void* self, uint32_t index, uint8_t a3, void* aura, int32_t spell_id))
WXL_SEAM_RAISES(Unit, OnAuraRemoved, UnitAuraChanged)
WXL_SEAM_RAISES(Unit, OnAuraRemoved, UnitAuraRemoved)

// Sends one movement message of the unit the player controls: builds the MSG_MOVE_* named by
// msg_id over the unit's movement block and hands it to the connection. Every movement the
// local player sends goes through it -- the input's starts and stops, the floodsafe turns and
// pitches, the heartbeats, the acks -- from ProcessLocalMoveEvent and the floodsafe handlers.
// The one-argument overload of the same name (0x00724E70) forwards here; the address picks
// this one. A non-static member, its six arguments on the stack: thiscall. Before raises PlayerMoveStart for a start, a jump, an ascent or a
// descent, PlayerMoveStop for a stop or a landing, and nothing for the rest.
WXL_SEAM_BEFORE(Unit, SendMovementUpdate, "CGUnit_C::SendMovementUpdate@0x0071F0C0", int32_t, thiscall, (void* self, uint32_t time, uint32_t msg_id, float value, uint32_t index, uint64_t transport, uint8_t seat))
WXL_SEAM_RAISES(Unit, SendMovementUpdate, PlayerMoveStart)
WXL_SEAM_RAISES(Unit, SendMovementUpdate, PlayerMoveStop)

// The type mirror handler of UNIT_FIELD_MOUNTDISPLAYID: runs after the server wrote the field on
// any unit, with the unit's guid and the field's previous value by address, and has the unit
// change its mount. Reached only through CallMirrorFunctions, which pushes six dwords and
// cleans 0x18 at 0x004D5254; it reads the guid alone and ends in a bare `ret`: cdecl. Before
// raises UnitMountChanged with the display ids before and after.
WXL_SEAM_BEFORE(Unit, MountDisplayIDUpdateHandler, "MountDisplayIDUpdateHandler", int32_t, cdecl, (uint64_t guid, uint32_t field_offset, uint32_t field_size, const void* old_value, void* param))
WXL_SEAM_RAISES(Unit, MountDisplayIDUpdateHandler, UnitMountChanged)
WXL_SEAM_WITNESS(Unit, MountDisplayIDUpdateHandler, 0x004D5254)

// Readies a unit's model for the frame's animation: its render facing, the twist of its torso and
// head while it turns, its pitch. A virtual of CGObject_C, called for every object in view by
// CGWorldFrame::UpdateObject (0x004F8D10) right before the object animates; the player's
// override calls this one first. thiscall (frame), `ret 4` (0x0073E40D). After applies the head
// turns of wxl.pose over what the game just set on the head bone, follows the animations of
// wxl.animation on the unit (ending, playing again, handing back) and raises UnitAnimationEnded
// for those that ended, and lifts the active player onto ground wxl.terrain raised under them.
WXL_SEAM_AFTER(Unit, PreAnimate, "CGUnit_C::PreAnimate", void, thiscall, (void* self, void* frame))
WXL_SEAM_RAISES(Unit, PreAnimate, UnitAnimationEnded)

// The circles the game projects on the ground under a unit (wxl.selectioncircle). Each draws
// between the device's RsPush and RsPop: CGObject_C::SetCircleRenderStates binds the static
// CGObject_C::s_selectionTexture (Textures\UnitSelectTexture.blp) added onto the ground, then
// ProjectTex::Render2d projects it over a box around the unit, in a colour. Before tells the
// service which circle comes and for which unit, and puts a mod's texture in the static's place;
// After puts the game's back. Members: thiscall, no stack argument.
//
// The target's circle, a virtual called by CGWorldFrame::ClearTrackedObjects in the world pass
// for the unit CGObject_C::PreAnimate noted (CGGameUI::m_lockedTarget, unless it is the active
// player or the ObjectSelectionCircle CVar is 0): the reaction's colour
// (CGUnit_C::GetSelectionHighlightColor), and while the player attacks it a second, closing ring.
WXL_SEAM(Unit, RenderTargetSelection, "CGUnit_C::RenderTargetSelection", void, thiscall, (const void* self))

// The pet's new target: a ring closing on it for a second after the pet changes target, called
// by ClearTrackedObjects for the unit PreAnimate noted (CGPetInfo::GetTarget).
WXL_SEAM(Unit, RenderPetTargetSelection, "CGUnit_C::RenderPetTargetSelection", void, thiscall, (const void* self))

// The move marker: the pulsing circle where click-to-move or an attack move goes, drawn by the
// active mover from CGUnit_C::Render (every unit's, returning at once for the others).
WXL_SEAM(Unit, RenderAutoTrackCursor, "CGUnit_C::RenderAutoTrackCursor", void, thiscall, (void* self))

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
