//
// The Storage domain: the one function every file of the client is opened through, and the
// mounting and closing of its archives.

#ifndef WXL_SEAM_GATE
#error "define WXL_SEAM_GATE(domain, name, symbol, ret, conv, params) before including storage.def"
#endif

// Opens a file by name, from an archive or from the whole mounted set when the archive is
// null. Twenty callers across the engine -- models, textures, movies, sounds, the client
// databases -- so this is where a file is opened, whatever opens it. A class static declared
// STORMAPI: __stdcall.
//
// Gated: a handler of FileOpen may write a path into wxl_file_open_args::redirect to have that
// file opened instead. The gate never takes the call; it rewrites the name and lets the client's
// own open run. Called on every thread that opens files.
WXL_SEAM_GATE(Storage, OpenFile, "SFile::OpenEx", int32_t, stdcall, (void* archive, const char* name, uint32_t flags, void** result))
WXL_SEAM_RAISES(Storage, OpenFile, FileOpen)

// The same function, observed: a gate has no After, so the result of an open is a second row
// on the same address. On x86 both are links of one chain, this one attached after the gate and
// so nearer the function: it is handed the arguments the gate let through, the name a redirect
// chose included (where that name is found -- a folder, a source, an archive -- FindFile says
// later). On x64 the fork calls After at each of the function's
// returns, after the gate's test at its head.
//
// After raises FileOpened with the name that was opened, whether a file came back, and its size
// (0 when none did). Called on every thread that opens files; nothing is read when nobody
// listens, and on x64 the client skips the calls then. The runtime's own opens (the archive
// listing of wxl.storage's find) raise nothing, as they raise no FileOpen.
WXL_SEAM_AFTER(Storage, OpenEx, "SFile::OpenEx", int32_t, stdcall, (void* archive, const char* name, uint32_t flags, void** result))
WXL_SEAM_RAISES(Storage, OpenEx, FileOpened)

// Finds where a name lives: a file of the disk, of the loose-file table or of an archive. Called
// by SFile::OpenEx for an open from the whole mounted set, by SFile::FileExistsEx and by
// SFile::FileExists, so it is where every name the client looks for or opens is resolved. A
// static of System_SFile2: [ebp+8..0x1C] read, a bare `ret`, its three callers `add esp, 0x18`:
// cdecl. It answers in al; the gate answers the whole of eax.
//
// Gated: the runtime's sources answer here, by priority -- a folder of the search path, a mod's
// provider or the bytes a mod serves --, and a name some mod transforms is opened through the
// runtime's file layer. A folder's file is answered by rewriting the name to its path behind two
// backslashes, which the function then finds on the disk; a provider's, a served or a
// transformed file are answered by taking the call: the path the runtime's file layer opens,
// type SFILE_PLAIN (0), no archive. Called on every thread that opens files; nothing is done
// while no source and no transform is registered.
WXL_SEAM_GATE(Storage, FindFile, "System_SFile2::FindFile", int32_t, cdecl, (const char* name, char* path, uint32_t size, uint32_t flags, uint32_t* type, void** archive))

// The same function, observed: where a name was found, and that it was found nowhere. On x86 a
// second link of the chain, attached after the gate and nearer the function; on x64 the fork
// calls After at each of the function's returns after the gate's test. It is not reached when the
// gate took the call. The answer is in al alone: After reads its low byte.
//
// After notes, for the thread, the layer that holds the name -- an archive (`*archive`), a loose
// file, a folder of the search path -- for wxl.storage's hash_file; and when nothing has it, raises
// FileMissing: an open when `archive` is given (SFile::OpenEx), an existence check when it is null
// (SFile::FileExistsEx, SFile::FileExists). Never for the runtime's own lookups, nor a mod's
// wxl.storage calls. Called on every thread that opens files.
WXL_SEAM_AFTER(Storage, FindFileResult, "System_SFile2::FindFile", int32_t, cdecl, (const char* name, char* path, uint32_t size, uint32_t flags, uint32_t* type, void** archive))
WXL_SEAM_RAISES(Storage, FindFileResult, FileMissing)

// Mounts an archive by path: an .MPQ file, or a folder named like one. Nonzero, with an SArchive
// written through `archive`, when it was opened; its hash and block tables are read by then. A
// class static declared STORMAPI: __stdcall (`ret 0x10`). After raises ArchiveMounted for an
// archive it opened. Archive views (SFile::OpenPathAsArchive) are not mounts and raise nothing.
WXL_SEAM_AFTER(Storage, OpenArchive, "SFile::OpenArchive", int32_t, stdcall, (const char* path, int32_t priority, uint32_t flags, void** archive))
WXL_SEAM_RAISES(Storage, OpenArchive, ArchiveMounted)

// Closes an archive SFile::OpenArchive opened, and frees its SArchive. __stdcall (`ret 4`).
// Before raises ArchiveUnmounted while it is still whole.
WXL_SEAM_BEFORE(Storage, CloseArchive, "SFile::CloseArchive", int32_t, stdcall, (void* archive))
WXL_SEAM_RAISES(Storage, CloseArchive, ArchiveUnmounted)

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
