// The Texture domain: a seam on the function every named texture of the client is asked for
// through.

#ifndef WXL_SEAM_BEFORE
#error "define WXL_SEAM_BEFORE(domain, name, symbol, ret, conv, params) before including texture.def"
#endif

// Answers the texture a file name gives: from the texture cache when the client already holds
// it with the same flags, otherwise read (BLP, or TGA when the name says so) and cached. Every
// model's textures, the interface's, the terrain's and the sky's come through it, about seventy
// callers, so it runs on every reference, cached or not. The flags are a CGxTexFlags, one dword
// of bit fields passed by value. A free function, overloaded: cdecl, the caller cleans (`ret` at
// 0x004B97A4; four dwords read, [ebp+8] to [ebp+0x14]).
//
// Before raises TextureLoad with the name asked for, before the cache is looked at; nothing
// when nobody listens, and on x64 the client skips the call then.
WXL_SEAM_BEFORE(Texture, Create, "TextureCreate@0x004B9760", void*, cdecl, (const char* file_name, uint32_t tex_flags, void* status, uint32_t flags))
WXL_SEAM_RAISES(Texture, Create, TextureLoad)

// A texture's file, read by an asynchronous read, about to be decoded: the client's poll of the
// read queue (AsyncFileReadPollHandler) calls this with the texture, on the main thread, and it
// hands the bytes to PumpBlpTextureAsync (a register function, EAX and one stack dword), which
// gives them to a CBLPFile (CBLPFile::Source). Before notes the texture's name for BLPFile.Source,
// which raises TextureDecode. cdecl, the texture its one argument: [ebp+8], a bare `ret`; reached
// only through the read's callback pointer: the witness is that call.
WXL_SEAM_BEFORE(Texture, AsyncTextureSuccessCallback, "AsyncTextureSuccessCallback", void, cdecl, (void* texture))
WXL_SEAM_WITNESS(Texture, AsyncTextureSuccessCallback, 0x004B9B9E)    // AsyncFileReadPollHandler: call ecx; add esp, 4

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
