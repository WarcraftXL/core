//
// The Item domain: seams on CGItem_C, the client's items.
//
// UseItem is a non-static member: thiscall, `self` first. The mirror handlers are file statics
// whose address the client takes for its handler table: cdecl.

#ifndef WXL_SEAM_BEFORE
#error "define WXL_SEAM_BEFORE(domain, name, symbol, ret, conv, params) before including item.def"
#endif
#ifndef WXL_SEAM_GATE
#error "define WXL_SEAM_GATE(domain, name, symbol, ret, conv, params) before including item.def"
#endif

// The one request to use an item: from the action bar, the bags, the character sheet, the
// script. Checks what the client can check itself (a container, a locked item, the override
// bar, cooldowns, the lockout, bind-on-use with its dialog, ...) and then casts the item's
// spell through Spell_C::CastSpell. Answers whether the use was taken. `target` is the guid
// the interface aimed at, by address, null for none. thiscall: `this` in ECX (0x00708C2A
// `mov edi,ecx`), the two arguments on the stack and popped by `ret 8` (0x00708C77), its
// eight callers pushing two and cleaning nothing. Gate raises ItemUseRequest and takes the
// call when a handler refused it, answering 0, which is what the client answers for an item
// it cannot use; the spell cast the use would make is then never asked for.
WXL_SEAM_GATE(Item, UseItem, "CGItem_C::UseItem", int32_t, thiscall, (void* self, const uint64_t* target, int32_t confirmed))
WXL_SEAM_RAISES(Item, UseItem, ItemUseRequest)

// The type mirror handlers of ITEM_FIELD_DURABILITY and ITEM_FIELD_STACK_COUNT: run after the
// server wrote the field on any item, with the item's guid and the field's previous value by
// address; the first refreshes the paper doll's alerts and the second the bags and action bars.
// Reached only through CallMirrorFunctions (six dwords pushed, 0x18 cleaned at 0x004D5254); the
// durability one reads the guid and the value, the stack one the guid alone, and each ends in a
// bare `ret`: cdecl. Before raises ItemDurabilityChanged or ItemStackChanged when the value moved.
WXL_SEAM_BEFORE(Item, OnUpdateDurability, "OnUpdateDurability", int32_t, cdecl, (uint64_t guid, uint32_t field_offset, uint32_t field_size, const void* old_value, void* param))
WXL_SEAM_RAISES(Item, OnUpdateDurability, ItemDurabilityChanged)
WXL_SEAM_WITNESS(Item, OnUpdateDurability, 0x004D5254)
WXL_SEAM_BEFORE(Item, OnUpdateStackCount, "OnUpdateStackCount", int32_t, cdecl, (uint64_t guid, uint32_t field_offset, uint32_t field_size, const void* old_value, void* param))
WXL_SEAM_RAISES(Item, OnUpdateStackCount, ItemStackChanged)
WXL_SEAM_WITNESS(Item, OnUpdateStackCount, 0x004D5254)

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
