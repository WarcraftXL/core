// The SimpleTop domain: seams on the interface's root, which draws every frame of the UI.

#ifndef WXL_SEAM_AFTER
#error "define WXL_SEAM_AFTER(domain, name, symbol, ret, conv, params) before including simpletop.def"
#endif

// Draws the interface: builds and renders the batches of every frame stratum, from the bottom to
// the tooltips at the top. The interface's screen layer calls it from its paint (PaintScreen),
// once per frame Scrn.OnPaint draws. The world is drawn inside it, when the batches reach the
// world frame, so by the time it returns the world and the whole interface over it are drawn.
// After raises UiRenderEnd, the overlay slot. A layer above the interface -- the console, when it
// is open -- still draws after it.
WXL_SEAM_AFTER(SimpleTop, OnLayerRender, "CSimpleTop::OnLayerRender", void, thiscall, (void* self))
WXL_SEAM_RAISES(SimpleTop, OnLayerRender, UiRenderEnd)

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
