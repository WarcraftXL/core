// The ConsoleVar domain: seams on CVar, the client's console variables.

#ifndef WXL_SEAM_BEFORE
#error "define WXL_SEAM_BEFORE(domain, name, symbol, ret, conv, params) before including consolevar.def"
#endif
#ifndef WXL_SEAM
#error "define WXL_SEAM(domain, name, symbol, ret, conv, params) before including consolevar.def"
#endif
#ifndef WXL_SEAM_AFTER
#error "define WXL_SEAM_AFTER(domain, name, symbol, ret, conv, params) before including consolevar.def"
#endif

// Writes a variable's value: the string, the int and the float it parses to when set_value is
// set and the text differs from the current one; the reset and default values when asked and
// not yet held; the save flag. Every set ends here -- CVar::Set after the callback and the
// latch, Reset, Default, Update of a latched value, Register -- and a read-only variable
// returns before writing. A non-static member, the five arguments on the stack: thiscall.
// Before raises CVarChanged when the call will
// change the value: set_value set, the variable writable, and the text not the current one
// (compared without case, as the client compares it).
WXL_SEAM_BEFORE(ConsoleVar, InternalSet, "CVar::InternalSet", void, thiscall, (void* self, const char* value, uint8_t set_value, uint8_t set_reset, uint8_t set_default, uint8_t set_needs_save))
WXL_SEAM_RAISES(ConsoleVar, InternalSet, CVarChanged)

// Registers the console's set, cvar_reset, cvar_default and cvarlist, then reads Config.wtf: a
// `SET name "value"` line sets a variable already registered, and registers one nobody has yet
// with that value (archived, no default), which is how a later registration finds its saved
// value. Called once, early in InitializeGlobal, before any archive is opened. Before makes the
// registrations wxl.cvar kept waiting, so the file's lines reach them; After lets their latch
// flags take effect and marks the file read. A static, one stack argument, a bare `ret`: cdecl.
WXL_SEAM(ConsoleVar, Initialize, "CVar::Initialize", void, cdecl, (const char* file_name))

// Deletes every archived variable of the character category (flags & 0x30 == 0x20), when the
// player leaves the world (CGGameUI::Shutdown, after their values were written to the
// character's config-cache.wtf); the client registers its own again at the next world. After
// registers the mods' character variables again at once. No argument, a bare `ret`: cdecl.
WXL_SEAM_AFTER(ConsoleVar, DeleteCharacterCVars, "CVar::DeleteCharacterCVars", void, cdecl, ())

// Deletes every archived variable of the account category (flags & 0x30 == 0x10), when an
// account logs in (ClientServices::LoginServerStatus, authenticated). After registers the mods'
// account variables again at once. No argument, a bare `ret`: cdecl.
WXL_SEAM_AFTER(ConsoleVar, DeleteAccountCVars, "CVar::DeleteAccountCVars", void, cdecl, ())

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
