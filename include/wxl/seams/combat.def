// The Combat domain: seams on what the server reports of fights -- the handler of the melee
// messages in UnitCombat_C.cpp, and the CombatLog statics of UnitCombatLog_C.cpp that every
// spell log goes through, whether it came as a message of its own or inside
// SMSG_COMBAT_LOG_MULTIPLE.
//
// The handler is reached only through the handler table, with the four arguments every
// handler takes on the stack: cdecl. The statics each have two callers, the message's own
// handler and the multiple-log handler. HandlePeriodicAuraLog takes both its arguments on the
// stack (`push edi; push esi; call; add esp,8` at 0x006D41BF): cdecl. The three others take the
// message in a register and the time offset alone on the stack, cleaned by the caller: regparm,
// attached through their thunks in src/seams/RegparmX86.cpp, where the evidence for each is
// recorded. Every body reads the message from its cursor, without moving it, and raises nothing
// for a message cut short.

#ifndef WXL_SEAM_BEFORE
#error "define WXL_SEAM_BEFORE(domain, name, symbol, ret, conv, params) before including combat.def"
#endif

// The handler of SMSG_ATTACKSTART (full guids), SMSG_ATTACKSTOP and SMSG_COMBAT_EVENT_FAILED
// (packed guids and a facing flag), SMSG_ATTACKERSTATEUPDATE (a melee round), and
// SMSG_ENVIRONMENTALDAMAGELOG (a full guid, the cause and the amounts), among the swing errors
// and the target clear. Before raises CombatAttackStart or CombatAttackStop, CombatDamage or
// CombatMiss for a round by whether it landed, and CombatDamage for the environment.
WXL_SEAM_BEFORE(Combat, Packet_Group_29, "Packet_Group_29", int32_t, cdecl, (void* param, uint32_t msg_id, uint32_t time, void* msg))
WXL_SEAM_RAISES(Combat, Packet_Group_29, CombatAttackStart)
WXL_SEAM_RAISES(Combat, Packet_Group_29, CombatAttackStop)
WXL_SEAM_RAISES(Combat, Packet_Group_29, CombatDamage)
WXL_SEAM_RAISES(Combat, Packet_Group_29, CombatMiss)

// SMSG_SPELLLOGMISS: the spell id, the caster as a full guid, a debug flag, then a count of
// targets, each a full guid and a miss reason, with two floats after it when the flag is set.
// Before raises CombatMiss once per target.
//
// regparm: the message in EDI, the time offset on the stack. Evidence: 0x006D3090 (`mov ecx,edi`
// at 0x006D30A0, CDataStore::Get on it) and its callers, `mov edi,[ebp+0x14]; push 0` at
// 0x006D3204 and `mov edi,esi` at 0x006D419B, each cleaning one dword after the call.
WXL_SEAM_BEFORE(Combat, HandleSpellLogMiss, "CombatLog::HandleSpellLogMiss", int32_t, regparm, (void* msg, int32_t time_offset))
WXL_SEAM_RAISES(Combat, HandleSpellLogMiss, CombatMiss)

// SMSG_SPELLNONMELEEDAMAGELOG: the target and the caster as packed guids, the spell id, the
// damage, the overkill, the school, the absorbed and resisted amounts, a periodic flag, a
// spare byte, the blocked amount and the hit flags. Before raises CombatDamage.
//
// regparm: the message in EAX, the time offset on the stack. Evidence: 0x006D3840 (`mov esi,eax`
// at 0x006D384B) and its callers, `mov eax,[ebp+0x14]; push 0` at 0x006D3C13 and `mov eax,esi`
// at 0x006D41CC, each cleaning one dword after the call.
WXL_SEAM_BEFORE(Combat, HandleSpellNonMeleeDamageLog, "CombatLog::HandleSpellNonMeleeDamageLog", int32_t, regparm, (void* msg, int32_t time_offset))
WXL_SEAM_RAISES(Combat, HandleSpellNonMeleeDamageLog, CombatDamage)

// SMSG_SPELLHEALLOG: the target and the caster as packed guids, the spell id, the amount, the
// overheal, the absorbed amount and a crit flag. Before raises CombatHeal.
//
// regparm: the message in EAX, the time offset on the stack. Evidence: 0x006D3C30 (`mov esi,eax`
// at 0x006D3C3B) and its callers, `mov eax,[ebp+0x14]; push 0` at 0x006D3DD3 and `mov eax,esi`
// at 0x006D4191, each cleaning one dword after the call.
WXL_SEAM_BEFORE(Combat, HandleSpellHealLog, "CombatLog::HandleSpellHealLog", int32_t, regparm, (void* msg, int32_t time_offset))
WXL_SEAM_RAISES(Combat, HandleSpellHealLog, CombatHeal)

// SMSG_PERIODICAURALOG: the target and the caster as packed guids, the spell id, then a count
// of entries each led by its aura type: damage (3, 89), heal (8, 20), energize (21, 24) or
// drain (64); the client stops at any other. Before raises CombatDamage, CombatHeal or
// CombatEnergize per entry, in order, up to where the client would stop.
WXL_SEAM_BEFORE(Combat, HandlePeriodicAuraLog, "CombatLog::HandlePeriodicAuraLog", int32_t, cdecl, (void* msg, int32_t time_offset))
WXL_SEAM_RAISES(Combat, HandlePeriodicAuraLog, CombatDamage)
WXL_SEAM_RAISES(Combat, HandlePeriodicAuraLog, CombatHeal)
WXL_SEAM_RAISES(Combat, HandlePeriodicAuraLog, CombatEnergize)

// SMSG_SPELLENERGIZELOG: the target and the caster as packed guids, the spell id, the power
// type and the amount. Before raises CombatEnergize.
//
// regparm: the message in EAX, the time offset on the stack. Evidence: 0x006D3DF0 (`mov esi,eax`
// at 0x006D3DFB) and its callers, `mov eax,[ebp+0x14]; push 0` at 0x006D3EF3 and `mov eax,esi`
// at 0x006D4187, each cleaning one dword after the call.
WXL_SEAM_BEFORE(Combat, HandleSpellLogEnergizeLog, "CombatLog::HandleSpellLogEnergizeLog", int32_t, regparm, (void* msg, int32_t time_offset))
WXL_SEAM_RAISES(Combat, HandleSpellLogEnergizeLog, CombatEnergize)

// The two combat-log statics OnAuraUpdate calls for an aura that stays in its slot: the dose
// one when its stack count moved, the refresh one when only its end time did. Each has that one
// caller (0x0072FAB3 pushes six and cleans 0x18, 0x0072FB34 pushes four and cleans 0x10), reads
// its arguments at [ebp+8] on and ends in a bare `ret`: cdecl. `aura` is the slot as the update
// left it; a6 and a4 are the harmful bit of its flags. Before raises UnitAuraRefreshed with the
// slot and the count before.
WXL_SEAM_BEFORE(Combat, UnitCombatLogAuraDose, "UnitCombatLogAuraDose", void, cdecl, (void* unit, const void* aura, int32_t spell_id, int32_t old_stack, int32_t new_stack, uint8_t a6))
WXL_SEAM_RAISES(Combat, UnitCombatLogAuraDose, UnitAuraRefreshed)
WXL_SEAM_BEFORE(Combat, UnitCombatLogAuraRefreshed, "UnitCombatLogAuraRefreshed", void, cdecl, (void* unit, const void* aura, int32_t spell_id, uint8_t a4))
WXL_SEAM_RAISES(Combat, UnitCombatLogAuraRefreshed, UnitAuraRefreshed)

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
