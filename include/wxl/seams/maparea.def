// The MapArea domain: seams on CMapArea, a loaded terrain tile.

#ifndef WXL_SEAM
#error "define WXL_SEAM(domain, name, symbol, ret, conv, params) before including maparea.def"
#endif
#ifndef WXL_SEAM_BEFORE
#error "define WXL_SEAM_BEFORE(domain, name, symbol, ret, conv, params) before including maparea.def"
#endif

// Builds one chunk of a tile: allocates the CMapChunk, links it to the tile, sets its indices
// and creates it from the tile's file buffer. The one caller is CMapArea::Update, for each chunk
// of the rectangle coming into view, which reads the chunk back from the tile's slot. On the stock
// client it answers nothing: it ends on the call to CMapChunk::Create, so EAX holds what Create
// left there (`ret 8` at 0x007D6BE9), and the row is void on both clients. CMapChunk::Create
// stores the chunk in the tile's m_mapChunks[16 * y + x] (0x007C6589) before it returns. Before
// raises TerrainChunkBuild with the map, the tile's index (CMapArea::m_index) and the chunk's
// indices, before the chunk's data is read. After reads the chunk from the tile's slot
// (binding map_area_chunk): wxl.terrain writes the edits mods made to it back into its heights
// and normals, then TerrainChunkLoaded is raised.
WXL_SEAM(MapArea, PrepareChunk, "CMapArea::PrepareChunk", void, thiscall, (void* self, int32_t chunk_x, int32_t chunk_y))
WXL_SEAM_RAISES(MapArea, PrepareChunk, TerrainChunkBuild)
WXL_SEAM_RAISES(MapArea, PrepareChunk, TerrainChunkLoaded)

// The end of a terrain tile's read. CMapArea::Load (0x007D7150) opens the tile's .adt, sizes a
// buffer and queues an asynchronous read of the whole file; the client's poll of the read queue
// (AsyncFileReadPollHandler) then calls this with the tile, on the main thread, and it walks the
// file's chunks (ProcessIffChunks). So the bytes are all there and nothing has read them yet.
// Before raises TerrainTileLoad with the tile's name, its place on the map's grid and the bytes,
// only while someone listens. cdecl, a static taking the tile as its one argument: [ebp+8] read,
// a bare `ret`; reached only through the read's callback pointer: the witness is that call.
WXL_SEAM_BEFORE(MapArea, AsyncCallback, "CMapArea::AsyncCallback", void, cdecl, (void* param))
WXL_SEAM_WITNESS(MapArea, AsyncCallback, 0x004B9B9E)    // AsyncFileReadPollHandler: call ecx; add esp, 4
WXL_SEAM_RAISES(MapArea, AsyncCallback, TerrainTileLoad)

// Points the tile at its file's chunks: CMapArea::m_header (the MHDR after MVER), the chunk index
// (MCIN), the placements and their names (MDDF, MODF, MMDX, MMID, MWMO, MWID), MFBO, the liquid
// (MH2O, a Liquid::CAreaData it allocates), the texture flags (MTXF), then CMapArea::LoadTextures
// on MTEX, all from MHDR's offsets. Its one caller is CMapArea::AsyncCallback (0x007D7029), on
// the main thread, with m_file still open. __thiscall, no argument, a bare `ret` (0x007D7014).
// A root of Cataclysm and later has no MCIN and an MHDR of zeros but for MFBO and MH2O (every
// root of a 37,768-tile retail survey): the client's own reading then sets the header, MFBO and
// the liquid as for any tile, and the rest to empty chunks it never follows (every count 0,
// LoadTextures of 0 bytes). Before asks the mods' tile providers for the tile's _tex0, _obj0
// and _obj1 and indexes them; After points the area's chunk index, placements, names and texture
// flags into them and loads _tex0's textures through CMapArea::LoadTextures. A root with MCIN is
// left alone.
WXL_SEAM(MapArea, ProcessIffChunks, "CMapArea::ProcessIffChunks", void, thiscall, (void* self))

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
