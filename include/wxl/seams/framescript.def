//
// The FrameScript domain: seams on the functions that create and destroy the client's script
// context, and the one that installs its event table.
//
// Every row is a free function: cdecl. The client runs one lua_State at a time, FrameScript's
// s_context, and rebuilds it at each change of interface: once at process start (InitializeClient),
// once when the glue comes up or comes back (CGlueMgr::Resume, through FrameScript_Flush), once
// when the game interface loads (CGGameUI::Initialize, ReloadUI included), and once on the way out
// of the world (CGGameUI::ShutdownGame, through FrameScript_Flush). The first and the last are
// placeholders: the client flushes them before it loads an interface into them, so only a context
// whose event table is installed (CreateEvents: the glue's and the game's, nothing else calls it)
// is announced. Which interface the new context serves is read from CGGameUI's own state at the
// time it is created.

#ifndef WXL_SEAM_AFTER
#error "define WXL_SEAM_AFTER(domain, name, symbol, ret, conv, params) before including framescript.def"
#endif
#ifndef WXL_SEAM_BEFORE
#error "define WXL_SEAM_BEFORE(domain, name, symbol, ret, conv, params) before including framescript.def"
#endif

// Creates the script context: a new lua_State with the base libraries, the error handler, the
// client's extra globals and compat.lua, in s_context. Returns 1. Three callers (InitializeClient,
// CGGameUI::InitializeFrameXML, FrameScript_Flush), the argument on the stack: cdecl. After
// notes which context it is (game when CGGameUI::m_loggingIn or CGGameUI::m_initialized is set,
// glue otherwise) and raises nothing: CreateEvents announces it.
WXL_SEAM_AFTER(FrameScript, Initialize, "FrameScript_Initialize", int32_t, cdecl, (int32_t profile))

// Destroys the script context: lua_close on s_context, the memory pool freed, the event hash and
// the event table cleared. Three callers (ShutdownClient, CGGameUI::InitializeFrameXML,
// FrameScript_Flush), no argument: cdecl. Before raises ScriptVmClosing, naming the context
// CreateEvents announced, while the state is still alive; a placeholder raises nothing.
WXL_SEAM_BEFORE(FrameScript, Destroy, "FrameScript_Destroy", void, cdecl, ())
WXL_SEAM_RAISES(FrameScript, Destroy, ScriptVmClosing)

// Installs the script event table of the interface coming up: s_scriptEvents is sized to count
// and each name becomes the event at its index, created in the event hash when it is not there
// yet. Two callers (CGlueMgr::Initialize with the glue's list, CGGameUI::InitializeFrameXML with
// the game's), both arguments on the stack: cdecl. After hands the installed list to wxl.script,
// which installs it again with the events mods declared appended behind it, and the first time in
// a context raises ScriptVmReady: the client's own functions are registered by then, its frames
// not yet loaded.
WXL_SEAM_AFTER(FrameScript, CreateEvents, "FrameScript_CreateEvents", void, cdecl, (const char** names, uint32_t count))
WXL_SEAM_RAISES(FrameScript, CreateEvents, ScriptVmReady)

// Fires one event to the interface: pushes the event's name, then one Lua value per `%` of
// the format string read from the va_list (b, d, f, s, u), and signals every listener. Every
// event the client fires reaches it: the variadic FrameScript_SignalEvent is a wrapper that
// does nothing but build the va_list (0x0081B530), and the one other caller passes its own.
// The index is read at [ebp+8] (0x0081ACA8), the three arguments on the stack, a bare `ret`
// (0x0081AE4E) and the other caller cleaning them (0x005326E8 `add esp,0xC`): cdecl. Before
// raises UiEvent with the event's name, the format, and the values rendered as text, when a
// mod listens; the client's own listeners are not consulted, so an event nothing in the
// interface registered for is raised all the same. Before also raises ChatAddonMessage when the
// event is CHAT_MSG_ADDON fired by CGChat::AddChatMessage for an addon message of the server,
// with the prefix, the text, the channel and the sender's name it carries (Chat.AddChatMessage),
// and WindowOpened or WindowClosed for the events that open or close a window on an NPC
// (GOSSIP_SHOW, MERCHANT_CLOSED, QUEST_DETAIL, ...), with whom the interface's "npc" names.
WXL_SEAM_BEFORE(FrameScript, vSignalEvent, "vFrameScript_SignalEvent", void, cdecl, (uint32_t index, const char* format, void* args))
WXL_SEAM_RAISES(FrameScript, vSignalEvent, UiEvent)
WXL_SEAM_RAISES(FrameScript, vSignalEvent, ChatAddonMessage)
WXL_SEAM_RAISES(FrameScript, vSignalEvent, WindowOpened)
WXL_SEAM_RAISES(FrameScript, vSignalEvent, WindowClosed)

// The error handler the client installs on every protected call of interface code: makes the
// error value a string, names the object that raised it, and hands it to the handler the
// interface set with seterrorhandler. A static whose address is the only reference to it
// (0x00819BFE, in FrameScript_Initialize), called by the VM as a lua_CFunction with the state
// at [ebp+8] (0x00819735) and a bare `ret` (0x0081980B): cdecl. Before raises ScriptError
// with the error value as the VM
// left it on top of the stack, before the client rewrites it.
WXL_SEAM_BEFORE(FrameScript, HandleError, "FrameScript_HandleError", int32_t, cdecl, (void* state))
WXL_SEAM_RAISES(FrameScript, HandleError, ScriptError)

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
