//
// The NetClient domain: seams on the two functions every message of the world connection goes
// through, in and out.
//
// The first two rows are gates: a handler of MessageReceived or MessageSent that writes WXL_TRUE
// through wxl_message_args::suppressed stops the message there.
//
// A message is a CDataStore positioned at its opcode: m_data + m_read is the opcode, and the
// body runs from just past it to m_size. The opcode's width is not the same in both directions
// -- the server writes a uint16, the client a uint32 -- so each body reads its own.

#ifndef WXL_SEAM_GATE
#error "define WXL_SEAM_GATE(domain, name, symbol, ret, conv, params) before including netclient.def"
#endif
#ifndef WXL_SEAM_AFTER
#error "define WXL_SEAM_AFTER(domain, name, symbol, ret, conv, params) before including netclient.def"
#endif
#ifndef WXL_SEAM_BEFORE
#error "define WXL_SEAM_BEFORE(domain, name, symbol, ret, conv, params) before including netclient.def"
#endif

// Dispatches one message that arrived from the world server to the handler registered for its
// opcode, and returns what that handler answered, or 0 when the opcode has none. The only
// caller is HandleData, which builds the CDataStore over the received bytes on its stack and
// throws away both the store and this result; so a Gate that takes the call need only
// answer 0, and may leave the store untouched. Gate raises MessageReceived and takes the
// call when a handler suppressed it, which is how a mod serves an opcode the client does not
// know.
WXL_SEAM_GATE(NetClient, ProcessMessage, "NetClient::ProcessMessage", int32_t, thiscall, (void* self, uint32_t time_received, void* message, int32_t unused))
WXL_SEAM_RAISES(NetClient, ProcessMessage, MessageReceived)

// Sends one finalised message to the world server, or holds it when the connection is suspended.
// Called from everything that talks to the server. Gate raises MessageSent and takes the
// call when a handler suppressed it, which stops the message being sent and being held.
WXL_SEAM_GATE(NetClient, Send, "NetClient::Send", void, thiscall, (void* self, void* message))
WXL_SEAM_RAISES(NetClient, Send, MessageSent)

// Takes the connection to the world server up, on the main thread: the event queue drains
// it from the client's own loop, not from the socket's thread. After raises Connected, once
// the client has moved itself into the connected state.
WXL_SEAM_AFTER(NetClient, HandleConnect, "NetClient::HandleConnect", int32_t, thiscall, (void* self))
WXL_SEAM_RAISES(NetClient, HandleConnect, Connected)

// Takes it down again, from the same queue. Before raises Disconnected, while the client
// still believes it is connected, so a handler sees the world as it was rather than as the
// teardown has already left it.
WXL_SEAM_BEFORE(NetClient, HandleDisconnect, "NetClient::HandleDisconnect", int32_t, thiscall, (void* self))
WXL_SEAM_RAISES(NetClient, HandleDisconnect, Disconnected)

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
