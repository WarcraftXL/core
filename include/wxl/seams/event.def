// The Event domain: seams on the scheduler that drives the client's ticks.

#ifndef WXL_SEAM_BEFORE
#error "define WXL_SEAM_BEFORE(domain, name, symbol, ret, conv, params) before including event.def"
#endif

// Dispatches EVENT_ID_UPDATE to the one scheduler context this client creates, once per
// iteration of the frame driver that actually ticked. Its two callers are the main loop
// (SchedulerThreadProcProcess, only on the branch where the wait timed out) and
// EventForceIdleProcessing, which drives the same sequence while a modal window move or resize
// holds the main loop; the two cannot run at the same time, so one call is one tick.
//
// elapsed_sec is seconds, computed by the caller from the millisecond clock. Before raises
// Update, ahead of the client's own EVENT_ID_UPDATE handlers, so a mod's tick runs before the
// game's. After raises nothing: the tick's fact is that it started.
//
// During scheduler teardown a context in SCHEDSTATE_CLOSED reaches this function and dispatches
// nothing; Update is still raised, with the time that elapsed.
//
// regparm: context in EDI, curr_time and elapsed_sec on the stack. The body reads EDI first
// (`lea esi, [edi+0x10]`, the context's critical section); the one caller sets EDI just before
// the call and cleans two stack slots after it.
WXL_SEAM_BEFORE(Event, DispatchUpdate, "IEvtDispatchUpdate", void, regparm, (void* context, uint32_t curr_time, float elapsed_sec))
WXL_SEAM_RAISES(Event, DispatchUpdate, Update)

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
