//
// The Input domain: a seam on the one function every window message of the client passes
// through.

#ifndef WXL_SEAM_GATE
#error "define WXL_SEAM_GATE(domain, name, symbol, ret, conv, params) before including input.def"
#endif

// The client's window procedure: keyboard, mouse, focus, resize, and everything else Windows
// sends it. A free function with external linkage, declared in Engine/Source/Os/Input.h and
// installed as the window class's procedure, so its convention is the platform's default.
//
// Gated: a handler of Input that writes WXL_TRUE through wxl_input_args::handled keeps the
// message from the client. A message the Input handlers leave to the client goes on to the
// mouse's events: WM_INPUT raises MouseMotion for a raw mouse report (wxl.input registers raw
// input for the window once a mod listens or captures the pointer), WM_MOUSEWHEEL raises
// MouseWheel, whose handler keeps the turn from the client the same way. Taking the call answers 0, a window procedure's answer for a message it
// handled -- right for keys, characters and mouse buttons, the messages a mod swallows.
//
// The x64 call site is in Engine/Source/Os/Win64/Input.cpp. The fork's Win32 configuration
// carries no runtime: the stock 32-bit client reaches this function by detour.
WXL_SEAM_GATE(Input, WindowProc, "OsWindowProc", intptr_t, cdecl, (void* window, uint32_t message, uintptr_t wparam, intptr_t lparam))
WXL_SEAM_RAISES(Input, WindowProc, Input)
WXL_SEAM_RAISES(Input, WindowProc, MouseMotion)
WXL_SEAM_RAISES(Input, WindowProc, MouseWheel)
