// The Gx domain: seams on the graphics device -- the present, and the device's loss and return.

#ifndef WXL_SEAM_BEFORE
#error "define WXL_SEAM_BEFORE(domain, name, symbol, ret, conv, params) before including gx.def"
#endif

// Flushes the last draw list and hands the back buffer to the device to show. Five callers: the
// three ends of Scrn.OnPaint, and two in the loading screen, which draws and presents its own
// frames outside the paint. Before raises FrameEnd, for the frame Scrn.OnPaint opened and only
// for that one: a present with no frame open -- the loading screen's, or the paint that found
// nothing to draw into -- raises nothing, so a mod never sees an end without its begin.
// About once a second, while a mod watches the address space (wxl.footprint), Before also
// raises MemoryPressure when the largest free block just fell under the threshold. For the frame
// it ends, Before raises RenderPoint with WXL_RENDER_POINT_AFTER_UI (the interface drawn), then,
// while a mod listens, opens a frame of the runtime's Dear ImGui, raises ImGuiFrame for the mods'
// windows and draws them, before FrameEnd.
WXL_SEAM_BEFORE(Gx, ScenePresent, "GxScenePresent", void, cdecl, ())
WXL_SEAM_RAISES(Gx, ScenePresent, FrameEnd)
WXL_SEAM_RAISES(Gx, ScenePresent, MemoryPressure)
WXL_SEAM_RAISES(Gx, ScenePresent, ImGuiFrame)
WXL_SEAM_RAISES(Gx, ScenePresent, RenderPoint)

// Releases everything the D3D9 device made that a Reset would invalidate: textures to recreate,
// shaders, the vertex and index pools. Three callers. Two are the device's resets, each
// immediately before IDirect3DDevice9::Reset: the scene finding the device lost
// (CGxDeviceD3d::ISceneBegin, 0x006A337F) and a resize (CGxDeviceD3d::DeviceWM, 0x0069029D). The
// third is the device being destroyed (CGxDeviceD3d::IDestroyD3d, 0x0069040B), which no
// SwapchainRestored follows. Before raises SwapchainLost, with the size about to go away, all
// three times: what a mod derived from the device has to go in every one of them. It is the D3D9
// device's own: a client run on another device does not reach it.
WXL_SEAM_BEFORE(Gx, ReleaseD3dResources, "CGxDeviceD3d::IReleaseD3dResources", void, thiscall, (void* self, int32_t free_textures))
WXL_SEAM_RAISES(Gx, ReleaseD3dResources, SwapchainLost)

// Runs the callbacks registered for a device that has come back. Both resets call it right after
// IDirect3DDevice9::Reset succeeds, and only then. Declared virtual on CGxDevice, and nothing
// calls it directly: it is reached through the four device vtables (0x00A2DDD4, 0x00A2E1AC,
// 0x00A2E72C, 0x00A2F514), every one of which holds this body -- no device overrides it, so a
// detour on it sees every call. Before raises SwapchainRestored with the size the device came
// back at, ahead of the client's own callbacks.
WXL_SEAM_BEFORE(Gx, NotifyOnDeviceRestored, "CGxDevice::NotifyOnDeviceRestored", void, thiscall, (void* self))
WXL_SEAM_RAISES(Gx, NotifyOnDeviceRestored, SwapchainRestored)

// Loads a shader program by name for each of its permutations, from
// "<path>\\<profile>\\<name>.bls" at the best profile the device takes, falling back to lower
// ones. Before raises ShaderLoad, only while someone listens. thiscall `(shaders, target, path,
// name, permutations)`, `ret 0x14`.
WXL_SEAM_BEFORE(Gx, IShaderLoad, "CGxDevice::IShaderLoad", void, thiscall, (void* self, void* shaders, uint32_t target, const char* path, const char* name, uint32_t permutations))
WXL_SEAM_RAISES(Gx, IShaderLoad, ShaderLoad)

// MSVC takes a file that expands to nothing outside its opening #ifndef X ... #endif for one
// guarded by X, and skips it when it is included again with X defined: this table is read
// several times in one translation unit, under shapes that may leave it empty. A directive
// after the rows keeps it from looking guarded.
#ifdef WXL_TABLE_END
#endif
