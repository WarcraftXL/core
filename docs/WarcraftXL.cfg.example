# WarcraftXL.cfg: the core's own settings. Extensions keep theirs in Extensions\<name>\<name>.ini.
#
# Location: next to Wow.exe (or one folder up).
#
# Format: KEY=value, one per line. '#' or ';' starts a comment. Spaces are tolerated.
# Priority: environment variable > this file > default.
# Booleans: 0/n/f = no, anything else = yes.
#
# Every key below is shown commented with its default value: uncomment a line to change it.

# ----------------------------------------------------------------------------- Logging
# Verbosity (trace|debug|info|warn|error|off). `debug` adds the per-event diagnostics.
#WXL_LOG_LEVEL=info
# Flush after every line, so a crash loses none (0: Warn and above at once, the rest every 64 lines).
#WXL_LOG_FLUSH=1
# Mirror every line to OutputDebugString (default: on when a debugger is attached).
#WXL_LOG_DEBUGSTRING=0

# ----------------------------------------------------------------------------- Storage
# A log line for every file a provider served or a transform reshaped.
#WXL_STORAGE_LOGS=0

# ----------------------------------------------------------------------------- Profiles
# The settings profile loaded at start (WTF\WarcraftXL\profiles\<name>.cfg).
#WXL_PROFILE=
